// ===== JEWISH HOLIDAYS & PARASHA =====
function getJewishInfo(dateStr) {
  if (!dateStr) return { holiday: '', parasha: '', isHoliday: false, isErevHoliday: false };
  const h = toHebrewDate(dateStr);
  if (!h.hebrewYear) return { holiday: '', parasha: '', isHoliday: false, isErevHoliday: false };

  // We need raw hd values - re-derive from toHebrewDate internals
  const parts = dateStr.split('-');
  const year = parseInt(parts[0]), month = parseInt(parts[1]) - 1, day = parseInt(parts[2]);
  const d = new Date(year, month, day);
  const dow = d.getDay(); // 0=Sun,6=Sat

  // Get Hebrew month/day via a small re-calc
  function gToJD(yr,mo,dy){const a=Math.floor((14-mo)/12),y=yr+4800-a,mn=mo+12*a-3;return dy+Math.floor((153*mn+2)/5)+365*y+Math.floor(y/4)-Math.floor(y/100)+Math.floor(y/400)-32045;}
  function jdToHeb(jd){const EPOCH=347995.5,jdn=Math.floor(jd+0.5);let yr=Math.floor((jdn-EPOCH)/365.24682)+1;function ys(y){const m=Math.floor((235*y-234)/19),p=12084+13753*m;let dd=m*29+Math.floor(p/25920);if((3*(dd+1))%7<3)dd++;return dd+347995;}while(ys(yr+1)<=jdn)yr++;while(ys(yr)>jdn)yr--;function lip(y){return(7*y+1)%19<7;}function mlen(y,m){if(m===2)return 29;if(m===3){const s=ys(y),n=ys(y+1);return(n-s)%10===5?30:29;}if(m===8){const s=ys(y),n=ys(y+1);return(n-s)%10===5?30:29;}if(m===6&&lip(y))return 30;if([1,3,5,7,11,13].includes(m))return 30;return 29;}function miy(y){return lip(y)?13:12;}let mo=1,dn=jdn-ys(yr)+1;for(let m=1;m<=miy(yr);m++){const ml=mlen(yr,m);if(dn<=ml){mo=m;break;}dn-=ml;}return{year:yr,month:mo,day:dn,leap:lip(yr)};}

  const jd = gToJD(year, month+1, day);
  const hd = jdToHeb(jd - 0.5);
  const hm = hd.month, hday = hd.day, hyr = hd.year, leap = hd.leap;

  // Map month for non-leap: month 6=Adar, 7=Nisan etc.
  // In leap year: 6=Adar1, 7=Adar2, 8=Nisan...
  // Standard month refs (non-leap): Tishri=1,Cheshvan=2,Kislev=3,Tevet=4,Shvat=5,Adar=6,Nisan=7,Iyar=8,Sivan=9,Tammuz=10,Av=11,Elul=12
  // Leap: Tishri=1,...Shvat=5,Adar1=6,Adar2=7,Nisan=8,Iyar=9,Sivan=10,Tammuz=11,Av=12,Elul=13
  const TISHRI=1,CHESHVAN=2,KISLEV=3,TEVET=4,SHVAT=5;
  const ADAR   = leap ? 7 : 6;
  const NISAN  = leap ? 8 : 7;
  const IYAR   = leap ? 9 : 8;
  const SIVAN  = leap ? 10 : 9;
  const TAMMUZ = leap ? 11 : 10;
  const AV     = leap ? 12 : 11;
  const ELUL   = leap ? 13 : 12;

  let holiday = '', isHoliday = false, isErevHoliday = false;

  // ---- HOLIDAYS ----
  const H = (mo, dy, name, erev=false) => {
    if (hm===mo && hday===dy) { if(erev){isErevHoliday=true;}else{isHoliday=true;} holiday=name; }
  };

  // Tishri
  H(TISHRI,1,'ראש השנה'); H(TISHRI,2,'ראש השנה');
  H(TISHRI,3,'צום גדליה');
  H(TISHRI,9,'ערב יוה"כ', true);
  H(TISHRI,10,'יום כיפור');
  H(TISHRI,14,'ערב סוכות', true);
  H(TISHRI,15,'סוכות');  H(TISHRI,16,'סוכות');
  H(TISHRI,17,'חול המועד');H(TISHRI,18,'חול המועד');H(TISHRI,19,'חול המועד');H(TISHRI,20,'חול המועד');
  H(TISHRI,21,'הושענא רבה');
  H(TISHRI,22,'שמיני עצרת');
  H(TISHRI,23,'שמחת תורה');
  // Kislev/Tevet — Chanuka (25 Kislev, 8 days)
  H(KISLEV,24,'ערב חנוכה', true);
  H(KISLEV,25,'חנוכה א׳'); H(KISLEV,26,'חנוכה ב׳'); H(KISLEV,27,'חנוכה ג׳'); H(KISLEV,28,'חנוכה ד׳'); H(KISLEV,29,'חנוכה ה׳');
  // Chanuka continues in Tevet (day 6,7,8 — Kislev has 29 or 30 days)
  H(TEVET,1,'חנוכה ו׳'); H(TEVET,2,'חנוכה ז׳'); H(TEVET,3,'חנוכה ח׳');
  // If Kislev has 30 days, day 30 is חנוכה ו׳ and Tevet shifts
  // (simplified — covers most years correctly)
  H(TEVET,10,'צום עשרה בטבת');
  H(SHVAT,15,'ט"ו בשבט');
  // Purim
  if (!leap) { H(ADAR,13,'תענית אסתר'); H(ADAR,14,'פורים'); H(ADAR,15,'שושן פורים'); }
  else { H(6,14,'פורים קטן'); H(ADAR,13,'תענית אסתר'); H(ADAR,14,'פורים'); H(ADAR,15,'שושן פורים'); }
  // Nisan
  H(NISAN,14,'ערב פסח', true);
  H(NISAN,15,'פסח'); H(NISAN,16,'פסח');
  H(NISAN,17,'חול המועד פסח'); H(NISAN,18,'חול המועד פסח'); H(NISAN,19,'חול המועד פסח'); H(NISAN,20,'חול המועד פסח');
  H(NISAN,21,'שביעי של פסח'); H(NISAN,22,'אחרון של פסח');
  H(NISAN,27,'יום השואה');
  // Iyar
  H(IYAR,4,'יום הזיכרון');
  H(IYAR,5,'יום העצמאות');
  H(IYAR,14,'פסח שני');
  H(IYAR,18,'ל"ג בעומר');
  H(IYAR,28,'יום ירושלים');
  // Sivan
  H(SIVAN,5,'ערב שבועות', true);
  H(SIVAN,6,'שבועות'); H(SIVAN,7,'שבועות');
  // Tammuz
  H(TAMMUZ,17,'צום י"ז בתמוז');
  // Av
  H(AV,9,'תשעה באב');
  H(AV,15,'ט"ו באב');

  // ---- PARASHA (שבתות) ----
  // Calculate parasha by week number from a known reference shabbat
  // Reference: Shabbat Bereshit 5784 = Oct 21, 2023
  const REF_JD = gToJD(2023, 10, 21); // Bereshit 5784
  const thisJD = jd;
  // Find the shabbat of this week
  const daysToShabbat = (6 - d.getDay() + 7) % 7;
  const shabbatJD = thisJD + daysToShabbat;
  const weeksDiff = Math.round((shabbatJD - REF_JD) / 7);

  // Full parasha cycle (54 weeks, repeating, with Israel schedule)
  const PARASHIOT = [
    'בראשית','נח','לך לך','וירא','חיי שרה','תולדות','ויצא','וישלח','וישב','מקץ',
    'ויגש','ויחי','שמות','וארא','בא','בשלח','יתרו','משפטים','תרומה','תצוה',
    'כי תשא','ויקהל','פקודי','ויקרא','צו','שמיני','תזריע','מצורע','אחרי מות','קדושים',
    'אמור','בהר','בחוקותי','במדבר','נשא','בהעלתך','שלח לך','קרח','חקת','בלק',
    'פינחס','מטות','מסעי','דברים','ואתחנן','עקב','ראה','שופטים','כי תצא','כי תבוא',
    'נצבים','וילך','האזינו','וזאת הברכה'
  ];
  // Combined parashiot (when doubled)
  const COMBINED = {
    22:'ויקהל-פקודי', 27:'תזריע-מצורע', 29:'אחרי מות-קדושים', 32:'בהר-בחוקותי', 42:'מטות-מסעי', 50:'נצבים-וילך'
  };

  let parasha = '';
  if (dow === 6) { // Shabbat
    const idx = ((weeksDiff % 54) + 54) % 54;
    parasha = COMBINED[idx] || PARASHIOT[idx] || '';
    // Special Shabbatot names
    if (hm===NISAN && hday>=8 && hday<=14) parasha = 'שבת הגדול';
    if (hm===ADAR && hday>=8 && hday<=14 && !leap) parasha = 'שבת זכור';
    if (hm===ADAR && hday>=1 && hday<=7 && !leap) parasha = 'שבת שקלים';
    if (hm===ADAR && hday>=22 && hday<=29 && !leap) parasha = 'שבת פרה';
    if (hm===TISHRI && hday===1) parasha = 'שבת ראש השנה';
    if (hm===TISHRI && hday===10) parasha = 'שבת יוה"כ';
    if (hm===TISHRI && (hday>=15&&hday<=21)) parasha = 'שבת חול המועד סוכות';
    if (hm===NISAN && (hday>=15&&hday<=21)) parasha = 'שבת חול המועד פסח';
    if (hm===SIVAN && (hday===6||hday===7)) parasha = 'שבת שבועות';
  }

  return { holiday, parasha, isHoliday, isErevHoliday, hMonth: hm, hDay: hday };
}

// Hebrew date conversion
function toHebrewDate(dateStr) {
  if (!dateStr) return { greg: '', hebrew: '', isShabbat: false, isFriday: false, dayName: '' };
  const gregMonths = ['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'];
  try {
    const parts = dateStr.split('-');
    const year = parseInt(parts[0]), month = parseInt(parts[1]) - 1, day = parseInt(parts[2]);
    const d = new Date(year, month, day);
    const greg = d.getDate() + ' ' + gregMonths[d.getMonth()] + ' ' + d.getFullYear();
    const dayOfWeek = d.getDay();
    const isShabbat = dayOfWeek === 6;
    const isFriday = dayOfWeek === 5;
    const dayNames = ['יום ראשון','יום שני','יום שלישי','יום רביעי','יום חמישי','יום שישי','שבת קודש'];
    const dayName = dayNames[dayOfWeek];

    // === Hebrew Calendar Calculation ===
    function hebrewFromJD(jd) {
      const EPOCH = 347998;
      const jdn = Math.floor(jd + 0.5);
      let year = Math.floor((jdn - EPOCH) / 365.24682) + 1;
      while (hebrewYearStart(year + 1) <= jdn) year++;
      while (hebrewYearStart(year) > jdn) year--;
      const months = hebrewMonthsInYear(year);
      let month = 1, dayNum = jdn - hebrewYearStart(year) + 1;
      for (let m = 1; m <= months; m++) {
        const mlen = hebrewMonthLen(year, m);
        if (dayNum <= mlen) { month = m; break; }
        dayNum -= mlen;
      }
      return { year, month, day: dayNum };
    }
    function hebrewYearStart(y) {
      const months = Math.floor((235 * y - 234) / 19);
      const parts = 12084 + 13753 * months;
      let day = months * 29 + Math.floor(parts / 25920);
      if ((3 * (day + 1)) % 7 < 3) day++;
      return day + 347998;
    }
    function isLeapYear(y) { return (7 * y + 1) % 19 < 7; }
    function hebrewMonthsInYear(y) { return isLeapYear(y) ? 13 : 12; }
    function hebrewMonthLen(y, m) {
      const ys = hebrewYearStart(y), yn = hebrewYearStart(y + 1);
      const yearLen = yn - ys;
      // Cheshvan (m=2): 30 only in complete year (len%10==5)
      if (m === 2) return (yearLen % 10 === 5) ? 30 : 29;
      // Kislev (m=3): 29 only in deficient year (len%10==3), else 30
      if (m === 3) return (yearLen % 10 === 3) ? 29 : 30;
      // Adar I in leap year (m=6): 30
      if (m === 6 && isLeapYear(y)) return 30;
      // Standard 30-day months: Tishri(1), Shvat(5), Nisan(7), Sivan(9), Av(11)
      if ([1,5,7,9,11].includes(m)) return 30;
      // All others: 29
      return 29;
    }
    function gregorianToJD(yr, mo, dy) {
      const a = Math.floor((14 - mo) / 12);
      const y = yr + 4800 - a;
      const mn = mo + 12 * a - 3;
      return dy + Math.floor((153 * mn + 2) / 5) + 365 * y + Math.floor(y / 4) - Math.floor(y / 100) + Math.floor(y / 400) - 32045;
    }

    const hebrewMonthNames     = ['','תשרי','חשון','כסלו','טבת','שבט','אדר','ניסן','אייר','סיון','תמוז','אב','אלול'];
    const hebrewMonthNamesLeap = ['','תשרי','חשון','כסלו','טבת','שבט','אדר א׳','אדר ב׳','ניסן','אייר','סיון','תמוז','אב','אלול'];
    const geresh = '\u05f3';
    const gershayim = '\u05f4';

    function numToHebrew(n) {
      const hundreds = ['','ק','ר','ש','ת','תק','תר','תש','תת','תתק'];
      const tens = ['','י','כ','ל','מ','נ','ס','ע','פ','צ'];
      const ones = ['','א','ב','ג','ד','ה','ו','ז','ח','ט'];
      let h = n % 1000;
      let result = '';
      if (h >= 100) { result += hundreds[Math.floor(h/100)]; h %= 100; }
      if (h === 15) { result += 'טו'; }
      else if (h === 16) { result += 'טז'; }
      else { if (h >= 10) { result += tens[Math.floor(h/10)]; h %= 10; } if (h > 0) result += ones[h]; }
      if (result.length === 1) return result + geresh;
      return result.slice(0, -1) + gershayim + result.slice(-1);
    }

    function dayToHebrew(n) {
      const ones = ['','א׳','ב׳','ג׳','ד׳','ה׳','ו׳','ז׳','ח׳','ט׳','י׳','י"א','י"ב','י"ג','י"ד','ט"ו','ט"ז','י"ז','י"ח','י"ט','כ׳','כ"א','כ"ב','כ"ג','כ"ד','כ"ה','כ"ו','כ"ז','כ"ח','כ"ט','ל׳'];
      return ones[n] || String(n);
    }

    const jd = gregorianToJD(year, month + 1, day);
    const hd = hebrewFromJD(jd);
    const mnames = isLeapYear(hd.year) ? hebrewMonthNamesLeap : hebrewMonthNames;
    const hebrew = dayToHebrew(hd.day) + ' ' + mnames[hd.month] + ' ' + numToHebrew(hd.year);

    return { greg, hebrew, hebrewYear: hd.year, isShabbat, isFriday, dayName };
  } catch(e) { return { greg: dateStr, hebrew: '', hebrewYear: '', isShabbat: false, isFriday: false, dayName: '' }; }
}

function populateContractEditModal(b) {
  // Fill all edit fields from booking data
  $('ce-name').value = b.name || '';
  $('ce-phone').value = b.phone || '';
  $('ce-email').value = b.email || '';
  $('ce-date-from').value = b.dateFrom || '';
  $('ce-date-to').value = b.dateTo || '';
  $('ce-parasha').value = b.parasha || '';
  $('ce-beds-sheets').value = b.bedsSheets || 0;
  $('ce-beds-no-sheets').value = b.bedsNoSheets || 0;
  $('ce-guests').value = b.guests || '';
  $('ce-amount').value = b.amount || '';
  // Calculate advance paid
  const advance = b._overrideAdvance !== undefined && b._overrideAdvance !== null ? b._overrideAdvance : (b.payments || []).filter(p => p.type === 'advance').reduce((a,p) => a+(p.amount||0), 0);
  $('ce-advance').value = advance || '';
  $('ce-advance-required').value = b._advanceRequired != null ? b._advanceRequired : '';
  $('ce-notes').value = b.notes || '';
  updateHebrewDatePreview();
  // Auto-expand the advanced section if there's already relevant data in it,
  // so nothing existing gets hidden from view; otherwise start collapsed.
  const hasAdvancedData = !!(b.email || b.guests || advance || (b._advanceRequired != null) || b.notes);
  setContractAdvancedOpen(hasAdvancedData);
}

function toggleContractAdvanced() {
  const open = $('ce-advanced-section').style.display !== 'none';
  setContractAdvancedOpen(!open);
}
function setContractAdvancedOpen(open) {
  $('ce-advanced-section').style.display = open ? 'block' : 'none';
  $('ce-advanced-arrow').textContent = open ? '▴' : '▾';
}

function updateHebrewDatePreview() {
  const dateFrom = $('ce-date-from').value;
  const dateTo = $('ce-date-to').value;
  const parasha = $('ce-parasha').value;
  let html = '';
  if (dateFrom) {
    const h = toHebrewDate(dateFrom);
    html += `<span style="font-weight:700;color:var(--text)">${h.dayName}, ${h.greg}</span>`;
    if (h.isShabbat) html += ` <span style="color:#c8960b;font-weight:800">✦ שבת קודש ✦</span>`;
    if (h.isFriday) html += ` <span style="color:#22c55e">(ערב שבת)</span>`;
  }
  if (dateTo && dateTo !== dateFrom) {
    const h2 = toHebrewDate(dateTo);
    html += ` — <span style="font-weight:600">${h2.dayName}, ${h2.greg}</span>`;
  }
  if (parasha) html += `<br><span style="color:#7a5c12;font-size:12px">📖 ${parasha}</span>`;
  $('ce-date-preview').innerHTML = html || '<span style="color:var(--text3)">בחר תאריך לתצוגה מקדימה</span>';
}

function generateContractFromEdit() {
  const id = window._contractBookingId;
  const b = state.bookings.find(x => x.id === id);
  if (!b) return;
  // Read edited values
  const editedBooking = {
    ...b,
    name: $('ce-name').value || b.name,
    phone: $('ce-phone').value || b.phone,
    email: $('ce-email').value || b.email,
    dateFrom: $('ce-date-from').value || b.dateFrom,
    dateTo: $('ce-date-to').value || b.dateTo,
    parasha: $('ce-parasha').value || b.parasha,
    bedsSheets: Number($('ce-beds-sheets').value) || b.bedsSheets || 0,
    bedsNoSheets: Number($('ce-beds-no-sheets').value) || b.bedsNoSheets || 0,
    guests: Number($('ce-guests').value) || b.guests || 0,
    amount: Number($('ce-amount').value) || b.amount || 0,
    notes: $('ce-notes').value || b.notes,
    // Override advance payment
    _overrideAdvance: Number($('ce-advance').value) || null,
    _advanceRequired: $('ce-advance-required').value !== '' ? Number($('ce-advance-required').value) : null,
  };
  closeModal('contract-edit-modal');
  openContractFromData(editedBooking);
}

