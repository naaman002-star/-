let laundryRows = [];

function openExpenseModal(id) {
  state.editingExpenseId = id || null;
  laundryRows = [];

  // Populate booking dropdown
  const sel = $('e-booking');
  sel.innerHTML = '<option value="">ללא קישור להזמנה</option>';
  state.bookings.filter(b => b.status !== 'cancelled').forEach(b => {
    const opt = document.createElement('option');
    opt.value = b.id;
    opt.textContent = `${b.name} — ${fmtDate(b.dateFrom)}`;
    sel.appendChild(opt);
  });

  if (id) {
    const e = state.expenses.find(x => x.id === id);
    if (!e) return;
    $('expense-modal-title').textContent = '✏️ עריכת הוצאות';
    sel.value = e.bookingId || '';
    $('e-date').value = e.date || '';
    $('e-broker').value = e.broker || '';
    $('e-cleaning').value = e.cleaning || '';
    $('e-other').value = e.other || '';
    $('e-income').value = e.income || '';
    $('e-notes').value = e.notes || '';
    laundryRows = (e.laundry || []).map(l => ({ ...l }));
  } else {
    $('expense-modal-title').textContent = '💸 הוצאות שבת';
    ['e-date','e-broker','e-cleaning','e-other','e-income','e-notes'].forEach(id => { $(id).value = ''; });
    $('e-date').value = new Date().toISOString().substring(0,10);
    sel.value = '';
    laundryRows = [];
  }
  renderLaundryRows();
  openModal('expense-modal');
}

function renderLaundryRows() {
  const container = $('laundry-list');
  container.innerHTML = '';
  laundryRows.forEach((l, i) => {
    const div = document.createElement('div');
    div.className = 'payment-row';
    div.innerHTML = `
      <input type="text" placeholder="שם המנקה" value="${l.name||''}" oninput="laundryRows[${i}].name=this.value" style="flex:2">
      <select onchange="laundryRows[${i}].category=this.value">
        <option value="cleaning" ${l.category==='cleaning'?'selected':''}>ניקיון</option>
        <option value="laundry" ${l.category==='laundry'?'selected':''}>כביסה</option>
        <option value="both" ${l.category==='both'?'selected':''}>שניהם</option>
      </select>
      <input type="number" placeholder="₪" value="${l.amount||''}" oninput="laundryRows[${i}].amount=this.value" style="max-width:90px">
      <button class="action-btn danger" onclick="laundryRows.splice(${i},1);renderLaundryRows()">🗑️</button>
    `;
    container.appendChild(div);
  });
}

function addLaundryRow() {
  laundryRows.push({ name: '', category: 'cleaning', amount: '' });
  renderLaundryRows();
}

function saveExpense() {
  const expense = {
    id: state.editingExpenseId || state.nextExpenseId++,
    bookingId: $('e-booking').value || null,
    date: $('e-date').value,
    broker: Number($('e-broker').value) || 0,
    cleaning: Number($('e-cleaning').value) || 0,
    other: Number($('e-other').value) || 0,
    income: Number($('e-income').value) || 0,
    laundry: laundryRows.map(l => ({ ...l, amount: Number(l.amount) || 0 })),
    notes: $('e-notes').value.trim(),
  };

  if (state.editingExpenseId) {
    const idx = state.expenses.findIndex(e => e.id === state.editingExpenseId);
    if (idx !== -1) state.expenses[idx] = expense;
  } else {
    state.expenses.push(expense);
  }

  save();
  closeModal('expense-modal');
  renderExpenses();
  renderDistribution();
  renderBookings();
}

function deleteExpense(id) {
  $('confirm-title').textContent = 'מחיקת הוצאה';
  $('confirm-msg').textContent = 'האם למחוק?';
  $('confirm-ok').onclick = () => {
    state.expenses = state.expenses.filter(e => e.id !== id);
    save(); closeModal('confirm-modal'); renderExpenses(); renderDistribution(); renderBookings();
  };
  openModal('confirm-modal');
}

function totalExpense(e) {
  return (e.broker||0) + (e.cleaning||0) + (e.other||0) + (e.laundry||[]).reduce((a,l)=>a+(l.amount||0),0);
}

function renderExpenses() {
  const container = $('expenses-list');
  if (!state.expenses.length) {
    container.innerHTML = `<div class="empty-state"><div class="empty-icon">💸</div><p>אין הוצאות רשומות</p><small>לחץ "הוסף הוצאות" להתחיל</small></div>`;
    return;
  }

  const sorted = [...state.expenses].sort((a,b) => (b.date||'') > (a.date||'') ? 1 : -1);
  container.innerHTML = sorted.map(e => {
    const total = totalExpense(e);
    const booking = e.bookingId ? state.bookings.find(b => b.id == e.bookingId) : null;
    const laundryHtml = (e.laundry||[]).map(l =>
      `<span class="badge badge-gray" style="margin-left:4px">${esc(l.name||'מנקה')} • ${l.category==='laundry'?'כביסה':l.category==='both'?'ניקיון+כביסה':'ניקיון'} • ${fmt(l.amount)}</span>`
    ).join('');
    const otherItemsHtml = (e.otherItems||[]).map(r =>
      `<span class="badge badge-gray" style="margin-left:4px">➕ ${esc(r.desc||'הוצאה')} • ${fmt(r.amount)}</span>`
    ).join('');

    return `<div class="card" style="border-right:3px solid var(--red)">
      <div class="card-header">
        <div>
          <div class="card-title">📅 ${fmtDate(e.date)} ${booking ? '• '+esc(booking.name) : ''}</div>
          <div class="card-subtitle">סה"כ הוצאות: <b style="color:var(--red)">${fmt(total)}</b></div>
          ${e.income ? `<div style="margin-top:4px;font-size:13px;font-weight:700;color:var(--green)">💰 הכנסה: ${fmt(e.income)}</div>` : ''}
          ${e.income ? `<div style="margin-top:2px;font-size:12px;font-weight:600;color:${e.income - total >= 0 ? 'var(--accent)' : 'var(--red)'}">📊 רווח נקי: ${e.income - total >= 0 ? '+' : ''}${fmt(e.income - total)}</div>` : ''}
        </div>
        <div style="display:flex;gap:6px">
          <button class="btn btn-outline btn-sm" onclick="openExpenseModal(${e.id})">✏️ ערוך</button>
          <button class="btn btn-danger btn-sm" onclick="deleteExpense(${e.id})">🗑️</button>
        </div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:8px;font-size:13px">
        ${e.income ? `<span class="badge badge-success">💰 התקבל: ${fmt(e.income)}</span>` : ''}
        ${e.broker ? `<span class="badge badge-blue">🤝 תיווך: ${fmt(e.broker)}</span>` : ''}
        ${e.cleaning ? `<span class="badge badge-orange">🧹 ניקיון: ${fmt(e.cleaning)}</span>` : ''}
        ${e.other ? `<span class="badge badge-gray">➕ אחר: ${fmt(e.other)}</span>` : ''}
      </div>
      ${laundryHtml ? `<div style="margin-top:8px">${laundryHtml}</div>` : ''}
      ${otherItemsHtml ? `<div style="margin-top:8px">${otherItemsHtml}</div>` : ''}
      ${e.notes ? `<div style="margin-top:8px;font-size:12px;color:var(--text3)">📝 ${esc(e.notes)}</div>` : ''}
    </div>`;
  }).join('');
}

