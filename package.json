function printContract() {
  const content = $('contract-content').innerHTML;
  const printWin = window.open('', '_blank');
  printWin.document.write(`<!DOCTYPE html>
<html dir="rtl" lang="he">
<head>
  <meta charset="UTF-8">
  <title>חוזה — פנינת השמחה</title>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&family=Frank+Ruhl+Libre:wght@400;700;900&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 210mm;
      height: 297mm;
      overflow: hidden;
      background: white;
      direction: rtl;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }
    @media print {
      @page { size: A4 portrait; margin: 0; }
    }
    .contract-share-bar { display: none !important; }
    .contract-paper { min-width: unset !important; width: 100% !important; }

    /* The wrapper scales the entire contract to fit A4 */
    #fit-wrapper {
      width: 900px;               /* natural render width */
      transform-origin: top right;
      transform: scale(0.834);    /* 794/952 ≈ fit 210mm */
    }
  </style>
</head>
<body>
  <div id="fit-wrapper">
    ${content}
  </div>
  <script>
    window.onload = function() {
      var wrapper = document.getElementById('fit-wrapper');
      var A4w = document.body.clientWidth;   // 210mm in px
      var A4h = document.body.clientHeight;  // 297mm in px
      wrapper.style.width  = A4w + 'px';
      wrapper.style.transform = 'none';
      var h = wrapper.scrollHeight;
      var w = wrapper.scrollWidth;
      var scale = Math.min(A4h / h, A4w / w, 1);
      wrapper.style.width = (A4w / scale) + 'px';
      wrapper.style.transformOrigin = 'top right';
      wrapper.style.transform = 'scale(' + scale + ')';
      setTimeout(function(){ window.print(); }, 1000);
    };
  <\/script>
</body>
</html>`);
  printWin.document.close();
}

function shareWhatsApp() {
  const b = window._contractBooking;
  if (!b) return;
  const text = `שלום *${b.name}* 🌿\n\n*חוזה השכרה — מתחם פנינת השמחה*\n\n` +
    `📅 מועד: ${fmtDate(b.dateFrom)}${b.dateTo && b.dateTo !== b.dateFrom ? ' — ' + fmtDate(b.dateTo) : ''}\n` +
    `🛏️ מיטות: ${b.bedsSheets || 0} עם מצעים + ${b.bedsNoSheets || 0} ללא מצעים\n` +
    `💰 סה"כ לתשלום: *${fmt(b.amount)}*\n` +
    `${remaining(b) > 0 ? '⏳ יתרה לתשלום: *' + fmt(remaining(b)) + '*' : '✅ שולם במלואו'}\n\n` +
    `אנא חתמו על החוזה ושלחו חתרום חזרה לפני הגעתכם.\n` +
    `לפרטים: 050-4132379\n\n_מתחם פנינת השמחה — לשמחה מושלמת ורגועה!_`;
  
  const phone = (b.phone || '').replace(/\D/g, '');
  const url = phone 
    ? `https://wa.me/972${phone.replace(/^0/, '')}?text=${encodeURIComponent(text)}`
    : `https://wa.me/?text=${encodeURIComponent(text)}`;
  window.open(url, '_blank');
}

function copyContractText() {
  const b = window._contractBooking;
  if (!b) return;
  const text = `חוזה השכרה — מתחם פנינת השמחה\n` +
    `===================================\n` +
    `לקוח: ${b.name}\n` +
    `טלפון: ${b.phone || ''}\n` +
    `מועד: ${fmtDate(b.dateFrom)}${b.dateTo && b.dateTo !== b.dateFrom ? ' — ' + fmtDate(b.dateTo) : ''}\n` +
    `סה"כ לתשלום: ${fmt(b.amount)}\n` +
    `יתרה: ${remaining(b) > 0 ? fmt(remaining(b)) : 'שולם במלואו'}\n`;
  navigator.clipboard.writeText(text).then(() => alert('הטקסט הועתק ללוח!')).catch(() => alert('שגיאה בהעתקה'));
}

</script>


