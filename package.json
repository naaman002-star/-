function renderDistribution() {
  // Update month filter
  const months = [...new Set([
    ...state.bookings.map(b => (b.dateFrom||'').substring(0,7)),
    ...state.expenses.map(e => (e.date||'').substring(0,7))
  ])].filter(Boolean).sort().reverse();

  const sel = $('dist-filter');
  const cur = sel.value;
  sel.innerHTML = '<option value="all">כל הזמן</option>';
  months.forEach(m => {
    const [y, mo] = m.split('-');
    sel.innerHTML += `<option value="${m}">${MONTHS_HE[parseInt(mo)-1]} ${y}</option>`;
  });
  sel.value = cur && months.includes(cur) ? cur : 'all';

  const filter = sel.value;
  const today = new Date().toISOString().substring(0,10);
  // Only count income from bookings whose event date has already passed or are marked as passed
  const filterBookings = state.bookings.filter(b => 
    b.status !== 'cancelled' && 
    (b.status === 'passed' || (b.dateTo || b.dateFrom || '') < today) &&
    (filter === 'all' || (b.dateFrom||'').startsWith(filter))
  );
  const filterExpenses = state.expenses.filter(e => filter === 'all' || (e.date||'').startsWith(filter));
  const filterTransfers = state.transfers.filter(t => filter === 'all' || (t.date||'').startsWith(filter));
  const filterDebts = (state.debts||[]).filter(d => filter === 'all' || (d.date||'').startsWith(filter));

  const totalIncome = filterBookings.reduce((a,b) => a+(b.amount||0), 0);
  const totalBroker = filterBookings.reduce((a,b) => a+(b.broker||0), 0) + filterExpenses.reduce((a,e) => a+(e.broker||0), 0);
  const totalCleaning = filterExpenses.reduce((a,e) => a+(e.cleaning||0), 0);
  const totalLaundry = filterExpenses.reduce((a,e) => a+(e.laundry||[]).reduce((x,l) => x+(l.amount||0), 0), 0);
  const totalOther = filterExpenses.reduce((a,e) => a+(e.other||0), 0);
  const totalExpenses = totalBroker + totalCleaning + totalLaundry + totalOther;
  const net = totalIncome - totalExpenses;
  // חישוב חלק כל שותף לפי סכימת עיגול של כל עסקה בנפרד (ולא עיגול חד-פעמי של הרווח הנטו),
  // כך שהתוצאה תואמת בדיוק לחישוב בכרטסת השותפים ולא נוצר פער עיגול מצטבר.
  const share1 = filterBookings.reduce((a,b) => a + Math.round((b.amount||0) * 3 / 5), 0)
               - filterExpenses.reduce((a,e) => a + Math.round(totalExpense(e) * 3 / 5), 0);
  const share2 = filterBookings.reduce((a,b) => a + Math.round((b.amount||0) * 2 / 5), 0)
               - filterExpenses.reduce((a,e) => a + Math.round(totalExpense(e) * 2 / 5), 0);

  const paid1 = filterTransfers.filter(t => t.partner === '1').reduce((a,t) => a+t.amount, 0);
  const paid2 = filterTransfers.filter(t => t.partner === '2').reduce((a,t) => a+t.amount, 0);
  const debt1 = filterDebts.filter(d => d.partner === '1').reduce((a,d) => a+d.amount, 0);
  const debt2 = filterDebts.filter(d => d.partner === '2').reduce((a,d) => a+d.amount, 0);
  // Total owed = share from profit + past debts
  const total1 = share1 + debt1;
  const total2 = share2 + debt2;
  const remaining1 = total1 - paid1;
  const remaining2 = total2 - paid2;

  const methodLabel = m => ({ transfer:'🏦 העברה', bit:'📱 Bit', paybox:'📱 Paybox', cash:'💵 מזומן', check:"📝 צ'ק", other:'🔄 אחר' }[m] || m);

  const container = $('distribution-content');
  // Count future (not yet realized) bookings for informational display
  const futureBookings = state.bookings.filter(b => b.status !== 'cancelled' && b.status !== 'passed' && (b.dateTo || b.dateFrom || '') >= today && (filter === 'all' || (b.dateFrom||'').startsWith(filter)));
  const futureIncome = futureBookings.reduce((a,b) => a+(b.amount||0), 0);

  const renderDistCard = (name, colorStyle, shareAmt, debtAmt, totalAmt, paidAmt, remAmt, partnerNum, barGradient) => {
    const pct = totalAmt ? Math.min(100, Math.round(paidAmt/totalAmt*100)) : 0;
    const remColor = remAmt > 0 ? 'var(--red)' : remAmt < 0 ? 'var(--accent)' : 'var(--green)';
    const remText = remAmt > 0
      ? 'נותר לתשלום: ' + fmt(remAmt)
      : remAmt < 0
        ? `✅ שולם במלואו — <span style="background:rgba(79,142,247,.15);border:1px solid rgba(79,142,247,.4);border-radius:6px;padding:2px 8px;font-size:13px;color:var(--accent)">זכות: ${fmt(Math.abs(remAmt))}</span>`
        : '✅ שולם במלואו';
    return `
      <div class="dist-card">
        <div class="dist-name">${name}</div>
        <div style="font-size:12px;color:var(--text3);margin-bottom:4px">${partnerNum==='1'?'3/5':'2/5'} מהרווח הנטו</div>
        <div class="dist-amount" style="${colorStyle}">${fmt(shareAmt)}</div>
        ${debtAmt > 0 ? `<div style="font-size:12px;color:var(--accent2);margin-top:4px;padding:4px 8px;background:rgba(167,139,250,.1);border-radius:6px;border:1px solid rgba(167,139,250,.25)">+ חוב עבר: ${fmt(debtAmt)}</div>
        <div style="font-size:14px;font-weight:800;color:var(--text);margin-top:4px">סה"כ מגיע: ${fmt(totalAmt)}</div>` : ''}
        <div style="font-size:12px;color:var(--green);margin-top:6px">הועבר: ${fmt(paidAmt)}</div>
        <div style="font-size:13px;font-weight:700;color:${remColor};margin-top:2px">${remText}</div>
        <div class="dist-bar" style="margin-top:10px"><div class="dist-bar-fill" style="width:${pct}%;${barGradient}"></div></div>
        <button class="btn btn-outline btn-sm" style="margin-top:10px;width:100%" onclick="openTransferModal();$('t-partner').value='${partnerNum}'">➕ רשום תשלום</button>
        <button class="btn btn-sm" style="margin-top:6px;width:100%;background:rgba(167,139,250,.15);border:1px solid rgba(167,139,250,.3);color:var(--accent2)" onclick="openDebtModal();$('d-partner').value='${partnerNum}'">📋 רשום חוב עבר</button>
      </div>`;
  };

  container.innerHTML = `
    <div style="background:rgba(79,142,247,.08);border:1px solid rgba(79,142,247,.25);border-radius:10px;padding:10px 14px;margin-bottom:14px;font-size:12px;color:var(--text2);">
      ℹ️ <b>הכנסות מוצגות רק עבור אירועים שתאריכם עבר.</b> הזמנות עתידיות לא נכללות בחלוקה.
      ${futureIncome > 0 ? `<span style="margin-right:10px;color:var(--accent2)">⏳ הכנסות עתידיות ממתינות: <b>${fmt(futureIncome)}</b> (${futureBookings.length} הזמנות)</span>` : ''}
    </div>
    <div class="stats-grid">
      <div class="stat-card green"><div class="stat-label">הכנסות שהתממשו</div><div class="stat-value pos">${fmt(totalIncome)}</div></div>
      <div class="stat-card red"><div class="stat-label">הוצאות</div><div class="stat-value neg">${fmt(totalExpenses)}</div></div>
      <div class="stat-card blue"><div class="stat-label">רווח נטו</div><div class="stat-value ${net>=0?'pos':'neg'}">${fmt(net)}</div></div>
    </div>

    <div class="card">
      <div class="card-title" style="margin-bottom:14px">📊 פירוט הוצאות</div>
      <div class="net-row"><span>🤝 תיווך</span><span class="neg">${fmt(totalBroker)}</span></div>
      <div class="net-row"><span>🧹 ניקיון</span><span class="neg">${fmt(totalCleaning)}</span></div>
      <div class="net-row"><span>👕 כביסות</span><span class="neg">${fmt(totalLaundry)}</span></div>
      <div class="net-row"><span>➕ הוצאות אחרות</span><span class="neg">${fmt(totalOther)}</span></div>
      <div class="net-row" style="border-top:2px solid var(--border);margin-top:6px"><span><b>סה"כ הוצאות</b></span><span class="neg"><b>${fmt(totalExpenses)}</b></span></div>
      <div class="net-row total"><span>💰 רווח נטו לחלוקה</span><span class="${net>=0?'pos':'neg'}">${fmt(net)}</span></div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:4px">
      ${renderDistCard("שותף א'", 'color:var(--green)', share1, debt1, total1, paid1, remaining1, '1', '')}
      ${renderDistCard("שותף ב'", 'color:var(--accent)', share2, debt2, total2, paid2, remaining2, '2', 'background:linear-gradient(90deg,var(--accent),var(--accent2))')}
    </div>

    ${filterTransfers.length ? `
    <div class="card" style="margin-top:14px">
      <div class="card-header">
        <div class="card-title">📋 היסטוריית העברות לשותפים</div>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>תאריך</th><th>שותף</th><th>סכום</th><th>אמצעי</th><th>הערה</th><th></th></tr></thead>
          <tbody>
            ${[...filterTransfers].sort((a,b)=>(b.date||'')>(a.date||'')?1:-1).map(t=>`
            <tr>
              <td>${fmtDate(t.date)}</td>
              <td><span class="badge ${t.partner==='1'?'badge-success':'badge-blue'}">שותף ${t.partner==='1'?"א'":"ב'"}</span></td>
              <td class="num gold-c">${fmt(t.amount)}</td>
              <td>${methodLabel(t.method)}</td>
              <td style="color:var(--text3);font-size:12px">${esc(t.note||'—')}</td>
              <td>
                <button class="action-btn" onclick="openTransferModal(${t.id})" title="ערוך">✏️</button>
                <button class="action-btn danger" onclick="deleteTransfer(${t.id})" title="מחק">🗑️</button>
              </td>
            </tr>`).join('')}
          </tbody>
        </table>
      </div>
    </div>` : ''}

    ${(state.debts||[]).length ? `
    <div class="card" style="margin-top:14px">
      <div class="card-header">
        <div class="card-title">📋 חובות עבר לשותפים</div>
        <button class="btn btn-sm" style="background:rgba(167,139,250,.15);border:1px solid rgba(167,139,250,.3);color:var(--accent2)" onclick="openDebtModal()">+ הוסף חוב</button>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>תאריך</th><th>שותף</th><th>סכום</th><th>תיאור</th><th></th></tr></thead>
          <tbody>
            ${[...(state.debts||[])].sort((a,b)=>(b.date||'')>(a.date||'')?1:-1).map(d=>`
            <tr>
              <td>${fmtDate(d.date)}</td>
              <td><span class="badge badge-purple">שותף ${d.partner==='1'?"א'":"ב'"}</span></td>
              <td class="num" style="color:var(--accent2)">${fmt(d.amount)}</td>
              <td style="font-size:12px;color:var(--text2)">${esc(d.desc||'—')}</td>
              <td>
                <button class="action-btn" onclick="openDebtModal(${d.id})" title="ערוך">✏️</button>
                <button class="action-btn danger" onclick="deleteDebt(${d.id})" title="מחק">🗑️</button>
              </td>
            </tr>`).join('')}
          </tbody>
        </table>
      </div>
    </div>` : ''}

    ${filterExpenses.length ? `
    <div class="card" style="margin-top:14px">
      <div class="card-title" style="margin-bottom:14px">👥 פירוט מנקים / כביסות</div>
      ${[...new Map(filterExpenses.flatMap(e => e.laundry||[]).map(l => [l.name, l])).values()].map(l => {
        const total = filterExpenses.flatMap(e => e.laundry||[]).filter(x => x.name===l.name).reduce((a,x)=>a+(x.amount||0),0);
        return `<div class="net-row"><span>${esc(l.name||'מנקה')} <span class="badge badge-gray">${l.category==='laundry'?'כביסה':l.category==='both'?'ניקיון+כביסה':'ניקיון'}</span></span><span class="neg">${fmt(total)}</span></div>`;
      }).join('')}
    </div>` : ''}
  `;
}

// ===== REPORTS (TABBED) =====
let currentReportTab = 'monthly';

function renderReports() {
  // Populate month filter
  const allMonths = [...new Set([
    ...state.bookings.map(b => (b.dateFrom||'').substring(0,7)),
    ...state.expenses.map(e => (e.date||'').substring(0,7)),
    ...state.transfers.map(t => (t.date||'').substring(0,7)),
  ])].filter(Boolean).sort().reverse();

  const rfMonth = $('rf-month');
  const curVal = rfMonth.value;
  rfMonth.innerHTML = '<option value="all">כל התקופות</option>';
  allMonths.forEach(m => {
    const [y, mo] = m.split('-');
    rfMonth.innerHTML += `<option value="${m}">${MONTHS_HE[parseInt(mo)-1]} ${y}</option>`;
  });
  if (allMonths.includes(curVal)) rfMonth.value = curVal;

  renderCurrentReport();
}

function switchReportTab(tab) {
  currentReportTab = tab;
  document.querySelectorAll('.tab[id^="rtab-"]').forEach(t => t.classList.remove('active'));
  $('rtab-' + tab).classList.add('active');
  // Show/hide method filter for payments and partner tabs
  const showMethod = ['payments','partner1','partner2'].includes(tab);
  $('rf-method').style.display = showMethod ? '' : 'none';
  renderCurrentReport();
}

function getReportFilters() {
  return {
    month: $('rf-month').value,
    type: $('rf-type').value,
    status: $('rf-status').value,
    method: $('rf-method').value,
  };
}

function filterBookingsForReport(f) {
  const todayStr = new Date().toISOString().substring(0,10);
  return state.bookings.filter(b => {
    if (f.month !== 'all' && !(b.dateFrom||'').startsWith(f.month)) return false;
    if (f.type !== 'all' && b.type !== f.type) return false;
    if (f.status === 'active' && (b.status === 'cancelled')) return false;
    else if (f.status !== 'all' && f.status !== 'active' && b.status !== f.status) return false;
    return true;
  });
}

function renderCurrentReport() {
  const f = getReportFilters();
  const container = $('reports-content');
  const todayStr = new Date().toISOString().substring(0,10);
  const mLabel = m => { const [y,mo]=m.split('-'); return `${MONTHS_HE[parseInt(mo)-1]} ${y}`; };
  const mthLabel = m => ({transfer:'🏦 העברה',bit:'📱 Bit',paybox:'📱 Paybox',cash:'💵 מזומן',check:"📝 צ'ק",other:'🔄 אחר'}[m]||m);

  if (currentReportTab === 'monthly') {
    const monthlyData = {};
    const passedBookings = state.bookings.filter(b => b.status !== 'cancelled' && (b.status === 'passed' || (b.dateTo || b.dateFrom || '') < todayStr));
    for (const b of passedBookings) {
      const mk = (b.dateFrom||'').substring(0,7);
      if (!mk || (f.month !== 'all' && mk !== f.month)) continue;
      if (f.type !== 'all' && b.type !== f.type) continue;
      if (!monthlyData[mk]) monthlyData[mk] = { income:0, expenses:0, bookings:0, paid:0, remaining:0 };
      monthlyData[mk].income += b.amount||0;
      monthlyData[mk].paid += totalPaid(b);
      monthlyData[mk].remaining += remaining(b);
      monthlyData[mk].bookings++;
    }
    for (const e of state.expenses) {
      const mk = (e.date||'').substring(0,7);
      if (!mk || (f.month !== 'all' && mk !== f.month)) continue;
      if (!monthlyData[mk]) monthlyData[mk] = { income:0, expenses:0, bookings:0, paid:0, remaining:0 };
      monthlyData[mk].expenses += totalExpense(e);
    }
    const months = Object.keys(monthlyData).sort().reverse();
    if (!months.length) { container.innerHTML = `<div class="empty-state"><div class="empty-icon">📊</div><p>אין נתונים</p></div>`; return; }
    const totInc = months.reduce((a,m)=>a+monthlyData[m].income,0);
    const totExp = months.reduce((a,m)=>a+monthlyData[m].expenses,0);
    const totNet = totInc - totExp;
    container.innerHTML = `
      <div class="stats-grid" style="margin-bottom:14px">
        <div class="stat-card green"><div class="stat-label">סה"כ הכנסות</div><div class="stat-value pos">${fmt(totInc)}</div></div>
        <div class="stat-card red"><div class="stat-label">סה"כ הוצאות</div><div class="stat-value neg">${fmt(totExp)}</div></div>
        <div class="stat-card blue"><div class="stat-label">רווח נטו</div><div class="stat-value ${totNet>=0?'pos':'neg'}">${fmt(totNet)}</div></div>
        <div class="stat-card gold"><div class="stat-label">חלק שותף א' (3/5)</div><div class="stat-value gold">${fmt(Math.round(totNet*3/5))}</div></div>
        <div class="stat-card purple"><div class="stat-label">חלק שותף ב' (2/5)</div><div class="stat-value" style="color:var(--accent2)">${fmt(Math.round(totNet*2/5))}</div></div>
      </div>
      <div class="card" id="printable-report">
        <div class="card-title" style="margin-bottom:14px">📅 סיכום חודשי</div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>חודש</th><th>הזמנות</th><th>הכנסות</th><th>הוצאות</th><th>רווח נטו</th><th>שותף א' (3/5)</th><th>שותף ב' (2/5)</th></tr></thead>
            <tbody>
              ${months.map(mk => {
                const d = monthlyData[mk];
                const net = d.income - d.expenses;
                return `<tr><td>${mLabel(mk)}</td><td>${d.bookings}</td><td class="num pos">${fmt(d.income)}</td><td class="num neg">${fmt(d.expenses)}</td><td class="num ${net>=0?'pos':'neg'}">${fmt(net)}</td><td class="num pos">${fmt(Math.round(net*3/5))}</td><td class="num" style="color:var(--accent)">${fmt(Math.round(net*2/5))}</td></tr>`;
              }).join('')}
              <tr style="font-weight:800;border-top:2px solid var(--border)"><td>סה"כ</td><td></td><td class="num pos">${fmt(totInc)}</td><td class="num neg">${fmt(totExp)}</td><td class="num ${totNet>=0?'pos':'neg'}">${fmt(totNet)}</td><td class="num pos">${fmt(Math.round(totNet*3/5))}</td><td class="num" style="color:var(--accent)">${fmt(Math.round(totNet*2/5))}</td></tr>
            </tbody>
          </table>
        </div>
      </div>`;
    return;
  }

  if (currentReportTab === 'income') {
    const books = filterBookingsForReport(f).filter(b => b.status !== 'cancelled');
    const total = books.reduce((a,b)=>a+(b.amount||0),0);
    const totalPaidSum = books.reduce((a,b)=>a+totalPaid(b),0);
    const totalRem = books.reduce((a,b)=>a+remaining(b),0);
    container.innerHTML = `
      <div class="stats-grid" style="margin-bottom:14px">
        <div class="stat-card green"><div class="stat-label">סה"כ הכנסות</div><div class="stat-value pos">${fmt(total)}</div><div class="stat-sub">${books.length} הזמנות</div></div>
        <div class="stat-card gold"><div class="stat-label">שולם</div><div class="stat-value gold">${fmt(totalPaidSum)}</div></div>
        <div class="stat-card red"><div class="stat-label">יתרה לגביה</div><div class="stat-value neg">${fmt(totalRem)}</div></div>
      </div>
      <div class="card" id="printable-report">
        <div class="card-title" style="margin-bottom:14px">💰 דוח הכנסות</div>
        <div class="table-wrap"><table>
          <thead><tr><th>תאריך</th><th>שם</th><th>סוג</th><th>פרשה/חג</th><th>סכום</th><th>שולם</th><th>יתרה</th><th>סטטוס</th></tr></thead>
          <tbody>
            ${books.sort((a,b)=>(b.dateFrom||'')>(a.dateFrom||'')?1:-1).map(b=>`
            <tr>
              <td>${fmtDate(b.dateFrom)}${b.dateTo&&b.dateTo!==b.dateFrom?' — '+fmtDate(b.dateTo):''}</td>
              <td><b>${esc(b.name)}</b>${b.phone?`<br><span style="font-size:11px;color:var(--text3)">${esc(b.phone)}</span>`:''}</td>
              <td>${typeLabel(b.type)}</td>
              <td style="font-size:12px;color:var(--text2)">${esc(b.parasha||'—')}</td>
              <td class="num pos">${fmt(b.amount)}</td>
              <td class="num" style="color:var(--green)">${fmt(totalPaid(b))}</td>
              <td class="num ${remaining(b)>0?'neg':'pos'}">${remaining(b)>0?fmt(remaining(b)):'✓'}</td>
              <td>${statusBadge(b.status)}</td>
            </tr>`).join('')}
            <tr style="font-weight:800;border-top:2px solid var(--border)"><td colspan="4">סה"כ</td><td class="num pos">${fmt(total)}</td><td class="num" style="color:var(--green)">${fmt(totalPaidSum)}</td><td class="num neg">${fmt(totalRem)}</td><td></td></tr>
          </tbody>
        </table></div>
      </div>`;
    return;
  }

  if (currentReportTab === 'expenses') {
    const exps = state.expenses.filter(e => f.month === 'all' || (e.date||'').startsWith(f.month)).sort((a,b)=>(b.date||'')>(a.date||'')?1:-1);
    const totExp = exps.reduce((a,e)=>a+totalExpense(e),0);
    const totBroker = exps.reduce((a,e)=>a+(e.broker||0),0);
    const totCleaning = exps.reduce((a,e)=>a+(e.cleaning||0),0);
    const totLaundry = exps.reduce((a,e)=>a+(e.laundry||[]).reduce((x,l)=>x+(l.amount||0),0),0);
    const totOther = exps.reduce((a,e)=>a+(e.other||0),0);
    container.innerHTML = `
      <div class="stats-grid" style="margin-bottom:14px">
        <div class="stat-card red"><div class="stat-label">סה"כ הוצאות</div><div class="stat-value neg">${fmt(totExp)}</div></div>
        <div class="stat-card red"><div class="stat-label">תיווך</div><div class="stat-value neg" style="font-size:20px">${fmt(totBroker)}</div></div>
        <div class="stat-card red"><div class="stat-label">ניקיון</div><div class="stat-value neg" style="font-size:20px">${fmt(totCleaning)}</div></div>
        <div class="stat-card red"><div class="stat-label">כביסה</div><div class="stat-value neg" style="font-size:20px">${fmt(totLaundry)}</div></div>
        <div class="stat-card red"><div class="stat-label">אחר</div><div class="stat-value neg" style="font-size:20px">${fmt(totOther)}</div></div>
      </div>
      <div class="card" id="printable-report">
        <div class="card-title" style="margin-bottom:14px">💸 דוח הוצאות</div>
        <div class="table-wrap"><table>
          <thead><tr><th>תאריך</th><th>קשור להזמנה</th><th>תיווך</th><th>ניקיון</th><th>כביסה</th><th>אחר</th><th>סה"כ</th><th>הערות</th></tr></thead>
          <tbody>
            ${exps.map(e => {
              const bk = e.bookingId ? state.bookings.find(b=>b.id==e.bookingId) : null;
              const laundryTotal = (e.laundry||[]).reduce((a,l)=>a+(l.amount||0),0);
              return `<tr>
                <td>${fmtDate(e.date)}</td>
                <td style="font-size:12px">${bk?esc(bk.name):'—'}</td>
                <td class="num neg">${e.broker?fmt(e.broker):'—'}</td>
                <td class="num neg">${e.cleaning?fmt(e.cleaning):'—'}</td>
                <td class="num neg">${laundryTotal?fmt(laundryTotal)+'<br><span style="font-size:10px;color:var(--text3)">'+(e.laundry||[]).map(l=>esc(l.name||'')).join(', ')+'</span>':'—'}</td>
                <td class="num neg">${e.other?fmt(e.other):'—'}</td>
                <td class="num neg"><b>${fmt(totalExpense(e))}</b></td>
                <td style="font-size:12px;color:var(--text3)">${esc(e.notes||'')}</td>
              </tr>`;
            }).join('')}
            <tr style="font-weight:800;border-top:2px solid var(--border)"><td colspan="2">סה"כ</td><td class="num neg">${fmt(totBroker)}</td><td class="num neg">${fmt(totCleaning)}</td><td class="num neg">${fmt(totLaundry)}</td><td class="num neg">${fmt(totOther)}</td><td class="num neg">${fmt(totExp)}</td><td></td></tr>
          </tbody>
        </table></div>
      </div>`;
    return;
  }

  if (currentReportTab === 'payments') {
    const mf = $('rf-method').value;
    // Collect all individual payments from bookings
    const allPayments = [];
    for (const b of filterBookingsForReport(f)) {
      for (const p of (b.payments||[])) {
        if (mf !== 'all' && p.method !== mf) continue;
        allPayments.push({ ...p, bookingName: b.name, bookingPhone: b.phone, bookingDate: b.dateFrom, bookingType: b.type });
      }
    }
    allPayments.sort((a,b)=>(b.date||'')>(a.date||'')?1:-1);
    const totPay = allPayments.reduce((a,p)=>a+(Number(p.amount)||0),0);
    const byMethod = {};
    allPayments.forEach(p => { byMethod[p.method] = (byMethod[p.method]||0)+(Number(p.amount)||0); });
    container.innerHTML = `
      <div class="stats-grid" style="margin-bottom:14px">
        <div class="stat-card gold"><div class="stat-label">סה"כ תשלומים</div><div class="stat-value gold">${fmt(totPay)}</div><div class="stat-sub">${allPayments.length} תנועות</div></div>
        ${Object.entries(byMethod).map(([m,v])=>`<div class="stat-card blue"><div class="stat-label">${mthLabel(m)}</div><div class="stat-value" style="font-size:20px;color:var(--accent)">${fmt(v)}</div></div>`).join('')}
      </div>
      <div class="card" id="printable-report">
        <div class="card-title" style="margin-bottom:14px">💳 דוח תשלומים</div>
        ${allPayments.length ? `<div class="table-wrap"><table>
          <thead><tr><th>תאריך תשלום</th><th>לקוח</th><th>תאריך אירוח</th><th>סוג</th><th>אמצעי</th><th>סוג תשלום</th><th>סכום</th><th>הערה</th></tr></thead>
          <tbody>
            ${allPayments.map(p=>`<tr>
              <td>${fmtDate(p.date)}</td>
              <td><b>${esc(p.bookingName)}</b>${p.bookingPhone?`<br><span style="font-size:11px;color:var(--text3)">${p.bookingPhone}</span>`:''}</td>
              <td>${fmtDate(p.bookingDate)}</td>
              <td>${typeLabel(p.bookingType)}</td>
              <td>${mthLabel(p.method)}</td>
              <td><span class="badge badge-gray">${{advance:'מקדמה',final:'סופי',partial:'חלקי'}[p.type]||p.type}</span></td>
              <td class="num gold-c"><b>${fmt(p.amount)}</b></td>
              <td style="font-size:12px;color:var(--text3)">${esc(p.note||'')}</td>
            </tr>`).join('')}
            <tr style="font-weight:800;border-top:2px solid var(--border)"><td colspan="6">סה"כ</td><td class="num gold-c">${fmt(totPay)}</td><td></td></tr>
          </tbody>
        </table></div>` : '<div class="empty-state"><p>אין תשלומים</p></div>'}
      </div>`;
    return;
  }

  // Partner ledger tabs
  if (currentReportTab === 'partner1' || currentReportTab === 'partner2') {
    const partnerNum = currentReportTab === 'partner1' ? '1' : '2';
    const partnerName = partnerNum === '1' ? "שותף א'" : "שותף ב'";
    const partnerFrac = partnerNum === '1' ? '3/5' : '2/5';
    const partnerRatio = partnerNum === '1' ? 3/5 : 2/5;
    const mf = $('rf-method').value;

    // All months with activity
    const allMonthsPartner = [...new Set([
      ...state.bookings.map(b=>(b.dateFrom||'').substring(0,7)),
      ...state.expenses.map(e=>(e.date||'').substring(0,7)),
      ...state.transfers.filter(t=>t.partner===partnerNum).map(t=>(t.date||'').substring(0,7)),
    ])].filter(Boolean).sort();

    const todayStr = new Date().toISOString().substring(0,10);
    // Build chronological ledger rows
    const rows = [];

    // Income entries (realized only)
    const incomeBooks = state.bookings.filter(b =>
      b.status !== 'cancelled' &&
      (b.status === 'passed' || (b.dateTo||b.dateFrom||'') < todayStr) &&
      (f.month === 'all' || (b.dateFrom||'').startsWith(f.month))
    );
    for (const b of incomeBooks) {
      const share = Math.round((b.amount||0) * partnerRatio);
      rows.push({ date: b.dateFrom||'', type: 'income', label: `הכנסה: ${esc(b.name)} (${typeLabel(b.type)})`, debit: 0, credit: share, ref: b.parasha||'' });
    }

    // Expense entries (reduce partner share)
    const expList = state.expenses.filter(e => f.month === 'all' || (e.date||'').startsWith(f.month));
    for (const e of expList) {
      const expShare = Math.round(totalExpense(e) * partnerRatio);
      if (expShare > 0) rows.push({ date: e.date||'', type: 'expense', label: `הוצאות ${fmtDate(e.date)}`, debit: expShare, credit: 0, ref: e.notes||'' });
    }

    // Transfer entries
    const transfers = state.transfers.filter(t =>
      t.partner === partnerNum &&
      (f.month === 'all' || (t.date||'').startsWith(f.month)) &&
      (mf === 'all' || t.method === mf)
    );
    for (const t of transfers) {
      rows.push({ date: t.date||'', type: 'transfer', label: `תשלום: ${mthLabel(t.method)}${t.note?' — '+t.note:''}`, debit: t.amount, credit: 0, ref: t.note||'' });
    }

    // Debt entries (past debts owed to partner = credit)
    const partnerDebts = (state.debts||[]).filter(d =>
      d.partner === partnerNum &&
      (f.month === 'all' || (d.date||'').startsWith(f.month))
    );
    for (const d of partnerDebts) {
      rows.push({ date: d.date||'', type: 'debt', label: `📋 חוב עבר: ${esc(d.desc||'')}`, debit: 0, credit: d.amount, ref: '' });
    }

    rows.sort((a,b)=>(a.date>b.date)?1:-1);

    // Running balance
    let balance = 0;
    const ledgerRows = rows.map(r => {
      balance += r.credit - r.debit;
      return { ...r, balance };
    });

    const totalCredit = rows.reduce((a,r)=>a+r.credit,0);
    const totalDebit = rows.reduce((a,r)=>a+r.debit,0);
    const netBalance = totalCredit - totalDebit;

    const transfersPaid = transfers.reduce((a,t)=>a+t.amount,0);
    const debtTotal = partnerDebts.reduce((a,d)=>a+d.amount,0);
    // עיגול לכל עסקה בנפרד (תואם בדיוק לשורות הכרטסת ולדוח חלוקת הרווחים)
    const totalOwed = incomeBooks.reduce((a,b)=>a+Math.round((b.amount||0)*partnerRatio),0)
                     - expList.reduce((a,e)=>a+Math.round(totalExpense(e)*partnerRatio),0)
                     + debtTotal;

    container.innerHTML = `
      <div class="stats-grid" style="margin-bottom:14px">
        <div class="stat-card gold"><div class="stat-label">חלק ברווח (${partnerFrac})</div><div class="stat-value gold">${fmt(totalOwed - debtTotal)}</div></div>
        ${debtTotal > 0 ? `<div class="stat-card purple"><div class="stat-label">חובות עבר</div><div class="stat-value" style="color:var(--accent2)">${fmt(debtTotal)}</div></div>` : ''}
        <div class="stat-card green"><div class="stat-label">הועבר לשותף</div><div class="stat-value pos">${fmt(transfersPaid)}</div></div>
        <div class="stat-card ${netBalance>0?'red':'green'}"><div class="stat-label">${netBalance>0?'יתרה לתשלום':'עודף ששולם'}</div><div class="stat-value ${netBalance>0?'neg':'pos'}">${fmt(Math.abs(netBalance))}</div></div>
      </div>
      <div class="card" id="printable-report">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:10px">
          <div>
            <div class="card-title">📒 כרטסת ${partnerName} — ${partnerFrac} מהרווח</div>
            <div class="card-subtitle">כל התנועות הכספיות${f.month!=='all'?' — '+mLabel(f.month):''}</div>
          </div>
          <button class="btn btn-gold btn-sm" onclick="printCurrentReport()">🖨️ הדפס כרטסת</button>
        </div>
        <div class="table-wrap"><table>
          <thead><tr><th>תאריך</th><th>תיאור</th><th>חובה (שולם)</th><th>זכות (מגיע)</th><th>יתרה</th></tr></thead>
          <tbody>
            ${ledgerRows.length ? ledgerRows.map(r=>`
            <tr style="${r.type==='transfer'?'background:rgba(52,211,153,.05)':r.type==='expense'?'background:rgba(248,113,113,.04)':r.type==='debt'?'background:rgba(167,139,250,.07)':''}">
              <td style="white-space:nowrap">${fmtDate(r.date)}</td>
              <td>
                <span style="font-size:13px">${r.label}</span>
                ${r.ref?`<br><span style="font-size:11px;color:var(--text3)">${esc(r.ref)}</span>`:''}
              </td>
              <td class="num ${r.debit?'neg':''}">${r.debit?fmt(r.debit):'—'}</td>
              <td class="num ${r.credit?'pos':''}">${r.credit?fmt(r.credit):'—'}</td>
              <td class="num ${r.balance>=0?'neg':'pos'}" style="font-weight:700">${fmt(Math.abs(r.balance))} ${r.balance>0?'לשלם':r.balance<0?'עודף':''}</td>
            </tr>`).join('') : '<tr><td colspan="5" style="text-align:center;color:var(--text3);padding:30px">אין תנועות בתקופה זו</td></tr>'}
          </tbody>
          ${ledgerRows.length ? `<tfoot style="border-top:2px solid var(--border)">
            <tr style="font-weight:800">
              <td colspan="2">סה"כ</td>
              <td class="num neg">${fmt(totalDebit)}</td>
              <td class="num pos">${fmt(totalCredit)}</td>
              <td class="num ${netBalance>0?'neg':'pos'}" style="font-weight:900;font-size:15px">${fmt(Math.abs(netBalance))} ${netBalance>0?'לתשלום':netBalance<0?'עודף':'מאוזן ✓'}</td>
            </tr>
          </tfoot>` : ''}
        </table></div>
      </div>`;
  }
}

function printCurrentReport() {
  const el = $('printable-report');
  if (!el) return;
  const partnerName = currentReportTab === 'partner1' ? "שותף א'" : currentReportTab === 'partner2' ? "שותף ב'" : '';
  const tabNames = { monthly:'דוח חודשי', income:'דוח הכנסות', expenses:'דוח הוצאות', payments:'דוח תשלומים', partner1:"כרטסת שותף א'", partner2:"כרטסת שותף ב'" };
  const title = tabNames[currentReportTab] || 'דוח';
  const w = window.open('', '_blank');
  w.document.write(`<!DOCTYPE html><html lang="he" dir="rtl"><head><meta charset="UTF-8"><title>${title}</title>
  <link href="https://fonts.googleapis.com/css2?family=Heebo:wght@400;700;800;900&display=swap" rel="stylesheet">
  <style>
    body { font-family: Heebo, sans-serif; direction: rtl; color: #1a1e2e; background: #fff; padding: 24px; font-size: 13px; }
    h1 { font-size: 20px; font-weight: 900; margin-bottom: 4px; }
    .sub { font-size: 12px; color: #666; margin-bottom: 20px; }
    table { width: 100%; border-collapse: collapse; }
    thead th { background: #f0f2f8; padding: 8px 10px; text-align: right; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .5px; border-bottom: 2px solid #dde0ee; }
    tbody tr { border-bottom: 1px solid #eee; }
    tbody tr:hover { background: #f9f9f9; }
    td { padding: 8px 10px; }
    tfoot td { background: #f0f2f8; font-weight: 800; padding: 10px; border-top: 2px solid #dde0ee; }
    .pos { color: #16a34a; } .neg { color: #dc2626; } .gold { color: #b45309; }
    .badge { display: inline-block; padding: 1px 7px; border-radius: 20px; font-size: 10px; font-weight: 700; border: 1px solid #ccc; }
    .summary { display: flex; gap: 20px; margin-bottom: 20px; flex-wrap: wrap; }
    .summary-box { background: #f5f6fb; border-radius: 10px; padding: 12px 18px; }
    .summary-box .lbl { font-size: 11px; color: #666; font-weight: 700; text-transform: uppercase; }
    .summary-box .val { font-size: 22px; font-weight: 900; }
    @media print { body { padding: 10px; } button { display: none; } }
  </style></head><body>
  <h1>🏨 ניהול קמפוס — ${title}</h1>
  <div class="sub">הופק: ${new Date().toLocaleDateString('he-IL')} ${new Date().toLocaleTimeString('he-IL')}</div>
  ${el.outerHTML}
  <script>window.onload=()=>window.print()<\/script>
  </body></html>`);
  w.document.close();
}

function exportCurrentReport() {
  const f = getReportFilters();
  const todayStr = new Date().toISOString().substring(0,10);
  let csvRows = [];
  let filename = 'report';

  if (currentReportTab === 'income') {
    filename = 'income_report';
    csvRows = [['תאריך','שם','טלפון','סוג','פרשה','סכום','שולם','יתרה','סטטוס']];
    filterBookingsForReport(f).filter(b=>b.status!=='cancelled').sort((a,b)=>(b.dateFrom||'')>(a.dateFrom||'')?1:-1).forEach(b => {
      csvRows.push([b.dateFrom||'',b.name||'',b.phone||'',b.type||'',b.parasha||'',b.amount||0,totalPaid(b),remaining(b),b.status||'']);
    });
  } else if (currentReportTab === 'expenses') {
    filename = 'expenses_report';
    csvRows = [['תאריך','קשור להזמנה','תיווך','ניקיון','כביסה','אחר','סה"כ','הערות']];
    state.expenses.filter(e=>f.month==='all'||(e.date||'').startsWith(f.month)).sort((a,b)=>(b.date||'')>(a.date||'')?1:-1).forEach(e => {
      const bk = e.bookingId?state.bookings.find(b=>b.id==e.bookingId):null;
      const laundryTotal=(e.laundry||[]).reduce((a,l)=>a+(l.amount||0),0);
      csvRows.push([e.date||'',bk?bk.name:'',e.broker||0,e.cleaning||0,laundryTotal,e.other||0,totalExpense(e),e.notes||'']);
    });
  } else if (currentReportTab === 'payments') {
    filename = 'payments_report';
    csvRows = [['תאריך תשלום','לקוח','טלפון','תאריך אירוח','סוג','אמצעי','סוג תשלום','סכום','הערה']];
    const mf = $('rf-method').value;
    for (const b of filterBookingsForReport(f)) {
      for (const p of (b.payments||[])) {
        if (mf!=='all'&&p.method!==mf) continue;
        csvRows.push([p.date||'',b.name||'',b.phone||'',b.dateFrom||'',b.type||'',p.method||'',p.type||'',p.amount||0,p.note||'']);
      }
    }
    csvRows.sort((a,b)=>b[0]>a[0]?1:-1);
  } else if (currentReportTab === 'partner1' || currentReportTab === 'partner2') {
    const pNum = currentReportTab==='partner1'?'1':'2';
    const ratio = pNum==='1'?3/5:2/5;
    filename = `partner${pNum}_ledger`;
    csvRows = [['תאריך','סוג','תיאור','חובה','זכות','יתרה']];
    const rows = [];
    state.bookings.filter(b=>b.status!=='cancelled'&&(b.status==='passed'||(b.dateTo||b.dateFrom||'')<todayStr)&&(f.month==='all'||(b.dateFrom||'').startsWith(f.month))).forEach(b=>{
      rows.push({date:b.dateFrom||'',type:'income',label:`הכנסה: ${b.name}`,debit:0,credit:Math.round((b.amount||0)*ratio)});
    });
    state.expenses.filter(e=>f.month==='all'||(e.date||'').startsWith(f.month)).forEach(e=>{
      rows.push({date:e.date||'',type:'expense',label:`הוצאות ${e.date}`,debit:Math.round(totalExpense(e)*ratio),credit:0});
    });
    state.transfers.filter(t=>t.partner===pNum&&(f.month==='all'||(t.date||'').startsWith(f.month))).forEach(t=>{
      rows.push({date:t.date||'',type:'transfer',label:`תשלום (${t.method}) ${t.note||''}`,debit:t.amount,credit:0});
    });
    rows.sort((a,b)=>a.date>b.date?1:-1);
    let bal=0;
    rows.forEach(r=>{bal+=r.credit-r.debit;csvRows.push([r.date,r.type,r.label,r.debit||'',r.credit||'',Math.abs(bal)+(bal>0?' לשלם':bal<0?' עודף':'')]);});
  } else {
    filename = 'monthly_report';
    csvRows = [['חודש','הזמנות','הכנסות','הוצאות','רווח נטו','שותף א\'','שותף ב\'']];
    const monthlyData = {};
    state.bookings.filter(b=>b.status!=='cancelled'&&(b.status==='passed'||(b.dateTo||b.dateFrom||'')<todayStr)).forEach(b=>{
      const mk=(b.dateFrom||'').substring(0,7);
      if(!mk||(f.month!=='all'&&mk!==f.month)) return;
      if(!monthlyData[mk]) monthlyData[mk]={income:0,expenses:0,bookings:0};
      monthlyData[mk].income+=b.amount||0; monthlyData[mk].bookings++;
    });
    state.expenses.forEach(e=>{
      const mk=(e.date||'').substring(0,7);
      if(!mk||(f.month!=='all'&&mk!==f.month)) return;
      if(!monthlyData[mk]) monthlyData[mk]={income:0,expenses:0,bookings:0};
      monthlyData[mk].expenses+=totalExpense(e);
    });
    Object.keys(monthlyData).sort().reverse().forEach(mk=>{
      const d=monthlyData[mk]; const net=d.income-d.expenses;
      csvRows.push([mk,d.bookings,d.income,d.expenses,net,Math.round(net*3/5),Math.round(net*2/5)]);
    });
  }

  const csv = '\uFEFF' + csvRows.map(r=>r.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(',')).join('\n');
  const blob = new Blob([csv], {type:'text/csv;charset=utf-8'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href=url; a.download=`${filename}_${new Date().toISOString().substring(0,10)}.csv`; a.click();
  URL.revokeObjectURL(url);
}

// ===== EXPORT =====
function exportData() {
  const data = JSON.stringify(state, null, 2);
  const blob = new Blob([data], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `campus_rental_backup_${new Date().toISOString().substring(0,10)}.json`;
  a.click();
  URL.revokeObjectURL(url);
}

async function exportZip() {
  // Dynamically load JSZip if not already loaded
  if (!window.JSZip) {
    await new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js';
      script.onload = resolve;
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }
  const zip = new JSZip();
  const dateStr = new Date().toISOString().substring(0,10);

  // JSON backup
  zip.file(`campus_backup_${dateStr}.json`, JSON.stringify(state, null, 2));

  // ICS calendar
  const active = state.bookings.filter(b => b.status !== 'cancelled');
  if (active.length) {
    let ics = `BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Campus Rental//IL\r\nCALSCALE:GREGORIAN\r\nMETHOD:PUBLISH\r\n`;
    for (const b of active) {
      const from = (b.dateFrom || '').replace(/-/g,'');
      const to = b.dateTo ? addDay(b.dateTo).replace(/-/g,'') : addDay(b.dateFrom).replace(/-/g,'');
      ics += `BEGIN:VEVENT\r\nUID:booking-${b.id}@campus-rental\r\nDTSTAMP:${new Date().toISOString().replace(/[-:]/g,'').substring(0,15)}Z\r\nDTSTART;VALUE=DATE:${from}\r\nDTEND;VALUE=DATE:${to}\r\nSUMMARY:${typeLabel(b.type)} - ${b.name}\r\nDESCRIPTION:טלפון: ${b.phone}\\nסכום: ${fmt(b.amount)}\r\nEND:VEVENT\r\n`;
    }
    ics += `END:VCALENDAR`;
    zip.file(`campus_calendar_${dateStr}.ics`, ics);
  }

  // CSV report
  const todayStr = new Date().toISOString().substring(0,10);
  const csvRows = [['שם','טלפון','סוג','תאריך מ','תאריך עד','סכום','שולם','יתרה','סטטוס','הערות']];
  for (const b of [...state.bookings].sort((a,b)=>(a.dateFrom||'')>(b.dateFrom||'')?1:-1)) {
    csvRows.push([b.name, b.phone||'', typeLabel(b.type).replace(/[^\u0000-\u007E\u05D0-\u05EA]/g,''), b.dateFrom||'', b.dateTo||'', b.amount||0, totalPaid(b), remaining(b), b.status||'', (b.notes||'').replace(/,/g,' ')]);
  }
  zip.file(`campus_bookings_${dateStr}.csv`, '\uFEFF' + csvRows.map(r=>r.join(',')).join('\n'));

  // Generate and download
  const content = await zip.generateAsync({ type: 'blob', compression: 'DEFLATE', compressionOptions: { level: 6 } });
  const url = URL.createObjectURL(content);
  const a = document.createElement('a');
  a.href = url;
  a.download = `campus_rental_${dateStr}.zip`;
  a.click();
  URL.revokeObjectURL(url);
  alert(`✅ קובץ ZIP נוצר בהצלחה!\nכולל: גיבוי JSON + יומן ICS + רשימת הזמנות CSV`);
}


function importICS(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const text = e.target.result;
      const events = parseICS(text);
      if (events.length === 0) {
        alert('❌ לא נמצאו אירועים בקובץ ה-ICS.');
        event.target.value = '';
        return;
      }
      if (!confirm(`📅 נמצאו ${events.length} אירועים בקובץ מגוגל.\n\nהאירועים יתווספו להזמנות הקיימות (לא ימחקו שום דבר).\nהאם להמשיך?`)) {
        event.target.value = '';
        return;
      }
      let added = 0;
      events.forEach(ev => {
        const booking = {
          id: 'ics_' + Date.now() + '_' + Math.random().toString(36).substr(2,6),
          name: ev.summary || 'אירוע מגוגל',
          phone: '',
          email: '',
          type: detectBookingType(ev.summary),
          dateFrom: ev.dateFrom,
          dateTo: ev.dateTo || ev.dateFrom,
          guests: 0,
          bedsSheets: 0,
          bedsNoSheets: 0,
          amount: 0,
          payments: [],
          status: 'confirmed',
          notes: (ev.description ? ev.description + '\n' : '') + (ev.location ? 'מיקום: ' + ev.location : '') + '\n[יובא מ-Google Calendar]',
          createdAt: new Date().toISOString()
        };
        state.bookings.push(booking);
        added++;
      });
      save();
      renderBookings();
      alert(`✅ יובאו ${added} אירועים בהצלחה!\n\nהם הופיעו ברשימת ההזמנות. ניתן לערוך כל אחד ולהוסיף פרטי תשלום.`);
    } catch (err) {
      alert('❌ שגיאה בקריאת קובץ ה-ICS: ' + err.message);
    }
    event.target.value = '';
  };
  reader.readAsText(file, 'UTF-8');
}

function parseICS(text) {
  const events = [];
  const lines = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
  // Unfold lines (lines starting with space/tab continue previous)
  const unfolded = lines.replace(/\n[ \t]/g, '');
  const blocks = unfolded.split('BEGIN:VEVENT');
  blocks.shift(); // remove header
  blocks.forEach(block => {
    const end = block.indexOf('END:VEVENT');
    const body = end > -1 ? block.substring(0, end) : block;
    const get = (key) => {
      const re = new RegExp('^' + key + '[^:]*:(.*)$', 'im');
      const m = body.match(re);
      return m ? m[1].trim().replace(/\\n/g, '\n').replace(/\\,/g, ',').replace(/\\;/g, ';') : '';
    };
    const parseDate = (raw) => {
      if (!raw) return '';
      const d = raw.replace(/[TZ]/g, '').replace(/^(\d{4})(\d{2})(\d{2}).*/, '$1-$2-$3');
      return d;
    };
    const summary = get('SUMMARY');
    const dtstart = parseDate(get('DTSTART'));
    const dtend = parseDate(get('DTEND'));
    if (summary && dtstart) {
      events.push({
        summary,
        dateFrom: dtstart,
        dateTo: dtend || dtstart,
        description: get('DESCRIPTION'),
        location: get('LOCATION')
      });
    }
  });
  return events;
}

function detectBookingType(summary) {
  if (!summary) return 'daily';
  const s = summary.toLowerCase();
  if (s.includes('שבת') || s.includes('shabbat') || s.includes('שב')) return 'shabbat';
  if (s.includes('חג') || s.includes('פסח') || s.includes('סוכות') || s.includes('ראש') || s.includes('holiday')) return 'holiday';
  return 'daily';
}

function importData(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = async function(e) {
    try {
      const imported = JSON.parse(e.target.result);
      if (!imported.bookings && !imported.expenses && !imported.transfers) {
        alert('❌ הקובץ אינו קובץ גיבוי תקין של התוכנה.');
        return;
      }
      if (!confirm(`📂 טוען גיבוי מ-${file.name}\n\nפעולה זו תחליף את כל הנתונים הקיימים.\nהאם להמשיך?`)) {
        event.target.value = '';
        return;
      }
      localStorage.setItem('campus_rental_state', JSON.stringify(imported));
      state = imported;
      await syncToCloud();
      alert('✅ הגיבוי נטען וסונכרן לענן בהצלחה! הדף יתרענן עכשיו.');
      location.reload();
    } catch (err) {
      alert('❌ שגיאה בקריאת הקובץ. ודא שזהו קובץ JSON תקין.');
    }
    event.target.value = '';
  };
  reader.readAsText(file);
}

