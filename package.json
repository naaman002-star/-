<script>
// ===== STATE =====
const $ = id => document.getElementById(id);

let state = {
  bookings: [],
  expenses: [],
  transfers: [],
  debts: [],
  calendarMonth: new Date().toISOString().substring(0,7),
  calendarSelectedDay: null,
  editingBookingId: null,
  editingExpenseId: null,
  nextBookingId: 1,
  nextExpenseId: 1,
  nextTransferId: 1,
  nextDebtId: 1,
};

// ===== PERSISTENCE (auto-synced across devices, no manual save) =====
let _syncTimer = null;
let _lastSyncedJSON = '';

function setSyncStatus(status) {
  // status: 'saving' | 'saved' | 'offline' | 'loading'
  const el = document.getElementById('sync-status');
  if (!el) return;
  const map = {
    saving: '🔄 שומר ומסנכרן...',
    saved: '✅ נשמר ומסונכרן לשרת',
    offline: '⚠️ נשמר במכשיר בלבד (אין חיבור לשרת)',
    loading: '🔄 טוען נתונים...',
  };
  el.textContent = map[status] || '';
  el.setAttribute('data-status', status);
}

function save() {
  // 1) Instant local write so the UI never waits on the network
  try { localStorage.setItem('campus_rental_state', JSON.stringify(state)); } catch(e) {}
  // 2) Debounced background sync to the cloud so all devices see it, no manual save needed
  setSyncStatus('saving');
  clearTimeout(_syncTimer);
  _syncTimer = setTimeout(syncToCloud, 400);
}

async function syncToCloud() {
  const json = JSON.stringify(state);
  try {
    const res = await fetch('/api/state', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-campus-password': localStorage.getItem('campus_password') || '' },
      body: json
    });
    if (!res.ok) throw new Error('save failed: ' + res.status);
    _lastSyncedJSON = json;
    setSyncStatus('saved');
  } catch (e) {
    setSyncStatus('offline');
  }
}

function load() {
  // Fast path: show whatever was last saved on this device immediately
  const raw = localStorage.getItem('campus_rental_state');
  if (raw) {
    try { state = { ...state, ...JSON.parse(raw) }; } catch(e) {}
  }
  // Then reconcile with the server copy (may hold newer data from another device)
  loadFromCloud(true);
}

async function loadFromCloud(isInitialLoad) {
  try {
    if (isInitialLoad) setSyncStatus('loading');
    const res = await fetch('/api/state', { headers: { 'x-campus-password': localStorage.getItem('campus_password') || '' } });
    if (!res.ok) throw new Error('load failed: ' + res.status);
    const cloudState = await res.json();
    const cloudJSON = JSON.stringify(cloudState);
    if (cloudState && Object.keys(cloudState).length && cloudJSON !== _lastSyncedJSON) {
      _lastSyncedJSON = cloudJSON;
      state = { ...state, ...cloudState };
      localStorage.setItem('campus_rental_state', cloudJSON);
      rerenderCurrentPage();
    }
    setSyncStatus('saved');
  } catch (e) {
    // No cloud copy yet (first run) or a transient error - not fatal
    setSyncStatus(isInitialLoad ? 'saved' : 'offline');
  }
}

function rerenderCurrentPage() {
  const activePage = document.querySelector('.page.active');
  const name = activePage ? activePage.id.replace('page-', '') : 'dashboard';
  if (name === 'dashboard') renderDashboard();
  if (name === 'bookings') renderBookings();
  if (name === 'calendar') renderCalendar();
  if (name === 'expenses') renderExpenses();
  if (name === 'distribution') renderDistribution();
  if (name === 'reports') renderReports();
}

// Pull the latest data whenever the tab/app becomes visible again
// (e.g. switching from phone to computer) so both stay in sync automatically
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState === 'visible') loadFromCloud(false);
});
window.addEventListener('focus', () => loadFromCloud(false));
setInterval(() => { if (document.visibilityState === 'visible') loadFromCloud(false); }, 20000);

// ===== NAV =====
function showPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  $('page-'+name).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => {
    if (n.getAttribute('onclick') && n.getAttribute('onclick').includes("'"+name+"'")) n.classList.add('active');
  });
  if (name === 'dashboard') renderDashboard();
  if (name === 'bookings') renderBookings();
  if (name === 'calendar') renderCalendar();
  if (name === 'expenses') renderExpenses();
  if (name === 'distribution') renderDistribution();
  if (name === 'reports') renderReports();
}

function openModal(id) { $(id).classList.add('open'); }
function closeModal(id) { $(id).classList.remove('open'); }
function toggleBackupMenu() {
  const menu = $('backup-menu');
  const arrow = $('backup-menu-arrow');
  const open = menu.style.display !== 'none';
  menu.style.display = open ? 'none' : 'block';
  arrow.style.transform = open ? 'rotate(0deg)' : 'rotate(180deg)';
}
function setServerPassword() {
  const current = localStorage.getItem('campus_password') || '';
  const pw = prompt('הזן את סיסמת השרת (אם הגדרת CAMPUS_PASSWORD בשרת). השאר ריק אם אין סיסמה:', current);
  if (pw === null) return;
  localStorage.setItem('campus_password', pw);
  alert('✅ הסיסמה נשמרה. טוען מחדש...');
  location.reload();
}

document.addEventListener('click', e => {
  if (e.target.classList.contains('modal-overlay')) e.target.classList.remove('open');
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') document.querySelectorAll('.modal-overlay.open').forEach(m => m.classList.remove('open'));
});

// ===== UTILS =====
function fmt(n) {
  return '₪' + Number(n || 0).toLocaleString('he-IL');
}
function fmtDate(d) {
  if (!d) return '';
  const [y, m, day] = d.split('-');
  return `${day}/${m}/${y}`;
}
function typeLabel(t) {
  return { shabbat: '🕯️ שבת', holiday: '✡️ חג/חופש', daily: '🌤️ יומי' }[t] || t;
}
function statusBadge(s) {
  if (s === 'confirmed') return '<span class="badge badge-success">מאושר</span>';
  if (s === 'pending') return '<span class="badge badge-gold">ממתין</span>';
  if (s === 'cancelled') return '<span class="badge badge-danger">בוטל</span>';
  if (s === 'passed') return '<span class="badge badge-gray">✅ עבר</span>';
  return '';
}
function totalPaid(booking) {
  return (booking.payments || []).reduce((a, p) => a + (Number(p.amount) || 0), 0);
}
function remaining(booking) {
  return (Number(booking.amount) || 0) - totalPaid(booking);
}

// ===== BOOKING MODAL =====
let paymentRows = [];
let roomRows = [];

function openBookingModal(id) {
  state.editingBookingId = id || null;
  paymentRows = [];
  roomRows = [];

  if (id) {
    const b = state.bookings.find(x => x.id === id);
    if (!b) return;
    $('booking-modal-title').textContent = '✏️ עריכת הזמנה';
    $('b-name').value = b.name || '';
    $('b-phone').value = b.phone || '';
    $('b-email').value = b.email || '';
    $('b-type').value = b.type || 'shabbat';
    $('b-date-from').value = b.dateFrom || '';
    $('b-date-to').value = b.dateTo || '';
    $('b-parasha').value = b.parasha || '';
    $('b-beds-sheets').value = b.bedsSheets || '';
    $('b-beds-no-sheets').value = b.bedsNoSheets || '';
    $('b-guests').value = b.guests || '';
    $('b-amount').value = b.amount || '';
    $('b-notes').value = b.notes || '';
    $('b-status').value = b.status || 'confirmed';
    $('b-broker').value = b.broker || '';
    paymentRows = (b.payments || []).map(p => ({ ...p }));
    roomRows = (b.rooms || []).map(r => ({ ...r }));
  } else {
    $('booking-modal-title').textContent = '📋 הזמנה חדשה';
    ['b-name','b-phone','b-email','b-date-from','b-date-to','b-parasha','b-beds-sheets','b-beds-no-sheets','b-guests','b-amount','b-notes','b-broker'].forEach(id => { $(id).value = ''; });
    $('b-type').value = 'shabbat';
    $('b-status').value = 'confirmed';
    paymentRows = [];
    roomRows = [];
  }
  updateDateFields();
  renderPaymentRows();
  renderRoomRows();
  openModal('booking-modal');
}

function updateDateFields() {
  const t = $('b-type').value;
  if (t === 'daily') {
    $('b-date-from-label').textContent = 'תאריך השכרה *';
    $('b-date-to-group').style.display = 'none';
  } else {
    $('b-date-from-label').textContent = 'תאריך כניסה *';
    $('b-date-to-group').style.display = '';
  }
}

function renderPaymentRows() {
  const container = $('payments-list');
  container.innerHTML = '';
  paymentRows.forEach((p, i) => {
    const div = document.createElement('div');
    div.className = 'payment-row';
    div.innerHTML = `
      <input type="number" placeholder="סכום ₪" value="${p.amount || ''}" oninput="paymentRows[${i}].amount=this.value" style="max-width:110px">
      <select onchange="paymentRows[${i}].method=this.value">
        <option value="cash" ${p.method==='cash'?'selected':''}>מזומן</option>
        <option value="transfer" ${p.method==='transfer'?'selected':''}>העברה</option>
        <option value="bit" ${p.method==='bit'?'selected':''}>Bit</option>
        <option value="paybox" ${p.method==='paybox'?'selected':''}>Paybox</option>
        <option value="check" ${p.method==='check'?'selected':''}>צ'ק</option>
        <option value="other" ${p.method==='other'?'selected':''}>אחר</option>
      </select>
      <select onchange="paymentRows[${i}].type=this.value">
        <option value="advance" ${p.type==='advance'?'selected':''}>מקדמה</option>
        <option value="final" ${p.type==='final'?'selected':''}>תשלום סופי</option>
        <option value="partial" ${p.type==='partial'?'selected':''}>חלקי</option>
      </select>
      <input type="date" value="${p.date || ''}" oninput="paymentRows[${i}].date=this.value" style="max-width:140px">
      <input type="text" placeholder="הערה" value="${p.note || ''}" oninput="paymentRows[${i}].note=this.value" style="max-width:140px">
      <button class="action-btn danger prow-del" onclick="paymentRows.splice(${i},1);renderPaymentRows()">🗑️</button>
    `;
    container.appendChild(div);
  });
}

function addPaymentRow() {
  paymentRows.push({ amount: '', method: 'transfer', type: 'advance', date: new Date().toISOString().substring(0,10), note: '' });
  renderPaymentRows();
}

function renderRoomRows() {
  const container = $('rooms-list');
  container.innerHTML = '';
  roomRows.forEach((r, i) => {
    const div = document.createElement('div');
    div.style.cssText = 'background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;margin-bottom:8px;';
    div.innerHTML = `
      <div style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
        <input type="text" placeholder="שם חדר (לדוגמא: חדר 1, חדר ירוק...)" value="${r.roomName||''}" oninput="roomRows[${i}].roomName=this.value" style="background:var(--surface3);border:1px solid var(--border);border-radius:6px;padding:7px 10px;color:var(--text);flex:1;outline:none;">
        <button class="action-btn danger" onclick="roomRows.splice(${i},1);renderRoomRows()">🗑️</button>
      </div>
      <textarea placeholder="אורחים בחדר זה (שם, גיל, מס' מיטות...)" oninput="roomRows[${i}].guests=this.value" style="background:var(--surface3);border:1px solid var(--border);border-radius:6px;padding:7px 10px;color:var(--text);width:100%;resize:vertical;min-height:56px;outline:none;font-family:Heebo,sans-serif;font-size:13px;">${r.guests||''}</textarea>
    `;
    container.appendChild(div);
  });
}

function addRoomRow() {
  roomRows.push({ roomName: '', guests: '' });
  renderRoomRows();
}

function saveBooking() {
  const name = $('b-name').value.trim();
  const phone = $('b-phone').value.trim();
  const amount = Number($('b-amount').value);
  const dateFrom = $('b-date-from').value;
  const type = $('b-type').value;

  if (!name || !phone || !amount || !dateFrom) {
    alert('נא למלא שם, טלפון, סכום ותאריך');
    return;
  }

  const booking = {
    id: state.editingBookingId || state.nextBookingId++,
    name, phone,
    email: $('b-email').value.trim(),
    type,
    dateFrom,
    dateTo: type === 'daily' ? dateFrom : ($('b-date-to').value || dateFrom),
    parasha: $('b-parasha').value.trim(),
    bedsSheets: Number($('b-beds-sheets').value) || 0,
    bedsNoSheets: Number($('b-beds-no-sheets').value) || 0,
    guests: Number($('b-guests').value) || 0,
    amount,
    payments: paymentRows.map(p => ({ ...p, amount: Number(p.amount) || 0 })),
    rooms: roomRows.map(r => ({ ...r })),
    notes: $('b-notes').value.trim(),
    status: $('b-status').value,
    broker: Number($('b-broker').value) || 0,
    createdAt: state.editingBookingId ? undefined : new Date().toISOString(),
  };

  if (state.editingBookingId) {
    const idx = state.bookings.findIndex(b => b.id === state.editingBookingId);
    if (idx !== -1) { booking.createdAt = state.bookings[idx].createdAt; state.bookings[idx] = booking; }
  } else {
    state.bookings.push(booking);
  }

  save();
  closeModal('booking-modal');
  renderBookings();
  renderDistribution();
}

function deleteBooking(id) {
  $('confirm-title').textContent = 'מחיקת הזמנה';
  $('confirm-msg').textContent = 'האם למחוק את ההזמנה? פעולה זו בלתי הפיכה.';
  $('confirm-ok').onclick = () => {
    state.bookings = state.bookings.filter(b => b.id !== id);
    save(); closeModal('confirm-modal'); renderBookings(); renderDistribution();
  };
  openModal('confirm-modal');
}

// ===== MARK AS PASSED =====
function markAsPassed(id) {
  const b = state.bookings.find(x => x.id === id);
  if (!b) return;
  b.status = 'passed';
  save();
  renderBookings();
  renderDistribution();
  // Open quick expense prompt
  openQuickExpenseModal(b);
}

function openQuickExpenseModalById(id) {
  const b = state.bookings.find(x => x.id === id);
  if (!b) return;
  openQuickExpenseModal(b);
}

function openQuickExpenseModal(b) {
  $('qe-booking-name').textContent = b.name || '';
  $('qe-booking-date').textContent = fmtDate(b.dateFrom);
  window._quickExpenseBookingId = b.id;
  const existing = state.expenses.find(e => e.bookingId == b.id);
  if (existing) {
    window._quickExpenseEditId = existing.id;
    $('qe-date').value = existing.date || b.dateTo || b.dateFrom || new Date().toISOString().substring(0,10);
    $('qe-broker').value = existing.broker || '';
    $('qe-cleaning').value = existing.cleaning || '';
    qeOtherRows = (existing.otherItems && existing.otherItems.length) ? existing.otherItems.map(r => ({ ...r })) : (existing.other ? [{ desc: '', amount: existing.other }] : []);
    $('qe-notes').value = existing.notes || '';
  } else {
    window._quickExpenseEditId = null;
    $('qe-date').value = b.dateTo || b.dateFrom || new Date().toISOString().substring(0,10);
    $('qe-broker').value = b.broker || '';
    $('qe-cleaning').value = '';
    qeOtherRows = [];
    $('qe-notes').value = '';
  }
  renderQeOtherRows();
  openModal('quick-expense-modal');
}

let qeOtherRows = [];
function renderQeOtherRows() {
  const container = $('qe-other-list');
  if (!container) return;
  container.innerHTML = qeOtherRows.map((r, i) => `
    <div style="display:flex;gap:6px;margin-top:6px;align-items:center">
      <input type="text" placeholder="תיאור ההוצאה" value="${r.desc||''}" oninput="qeOtherRows[${i}].desc=this.value" style="flex:2">
      <input type="number" placeholder="₪" min="0" value="${r.amount||''}" oninput="qeOtherRows[${i}].amount=this.value" style="max-width:100px">
      <button type="button" class="action-btn danger" onclick="qeOtherRows.splice(${i},1);renderQeOtherRows()">🗑️</button>
    </div>
  `).join('');
}
function addQeOtherRow() {
  qeOtherRows.push({ desc: '', amount: '' });
  renderQeOtherRows();
}

function saveQuickExpense() {
  const broker  = Number($('qe-broker').value)  || 0;
  const cleaning = Number($('qe-cleaning').value) || 0;
  const otherItems = qeOtherRows
    .map(r => ({ desc: (r.desc||'').trim(), amount: Number(r.amount) || 0 }))
    .filter(r => r.desc || r.amount);
  const other = otherItems.reduce((a, r) => a + r.amount, 0);
  const date    = $('qe-date').value;
  if (!date) { alert('נא לבחור תאריך'); return; }
  if (!broker && !cleaning && !other) { closeModal('quick-expense-modal'); return; }
  const expense = {
    id: window._quickExpenseEditId || state.nextExpenseId++,
    bookingId: window._quickExpenseBookingId || null,
    date,
    broker,
    cleaning,
    other,
    otherItems,
    income: 0,
    laundry: window._quickExpenseEditId ? (state.expenses.find(e => e.id === window._quickExpenseEditId)?.laundry || []) : [],
    notes: $('qe-notes').value.trim(),
  };
  if (window._quickExpenseEditId) {
    const idx = state.expenses.findIndex(e => e.id === window._quickExpenseEditId);
    if (idx !== -1) state.expenses[idx] = expense; else state.expenses.push(expense);
  } else {
    state.expenses.push(expense);
  }
  window._quickExpenseEditId = null;
  save();
  closeModal('quick-expense-modal');
  renderExpenses();
  renderDistribution();
  renderBookings();
}
function unmarkPassed(id) {
  const b = state.bookings.find(x => x.id === id);
  if (!b) return;
  b.status = 'confirmed';
  save();
  renderBookings();
  renderDistribution();
}

// ===== RENDER BOOKINGS =====
function renderDashboard() {
  const todayStr = new Date().toISOString().substring(0,10);
  const thisMonth = new Date().toISOString().substring(0,7);
  const active = state.bookings.filter(b => b.status !== 'cancelled' && b.status !== 'passed');
  const realizedBookings = state.bookings.filter(b => b.status !== 'cancelled' && (b.status === 'passed' || (b.dateTo || b.dateFrom || '') < todayStr));
  const futureBookings = active.filter(b => (b.dateFrom || '') >= todayStr).sort((a,b) => (a.dateFrom||'') > (b.dateFrom||'') ? 1 : -1);
  const totalIncome = realizedBookings.reduce((a,b) => a+(b.amount||0), 0);
  const monthExpenses = state.expenses.filter(e => (e.date||'').startsWith(thisMonth)).reduce((a,e) => a+totalExpense(e), 0);
  const monthIncome = realizedBookings.filter(b => (b.dateFrom||'').startsWith(thisMonth)).reduce((a,b) => a+(b.amount||0), 0);
  const monthNet = monthIncome - monthExpenses;
  const withBalance = active.map(b => ({ b, rem: remaining(b) })).filter(x => x.rem > 0).sort((a,b) => (a.b.dateFrom||'') > (b.b.dateFrom||'') ? 1 : -1);
  const totalRemaining = withBalance.reduce((a,x) => a+x.rem, 0);

  $('dashboard-stats').innerHTML = `
    <div class="stat-card blue"><div class="stat-label">הזמנות פתוחות</div><div class="stat-value">${active.length}</div><div class="stat-sub">${futureBookings.length} עתידיות</div></div>
    <div class="stat-card green"><div class="stat-label">הכנסות שהתממשו (סה"כ)</div><div class="stat-value pos">${fmt(totalIncome)}</div></div>
    <div class="stat-card ${monthNet >= 0 ? 'gold' : 'red'}"><div class="stat-label">רווח נטו החודש</div><div class="stat-value ${monthNet >= 0 ? 'gold' : 'neg'}">${fmt(monthNet)}</div><div class="stat-sub">הכנסות ${fmt(monthIncome)} • הוצאות ${fmt(monthExpenses)}</div></div>
    <div class="stat-card red"><div class="stat-label">יתרה לגביה</div><div class="stat-value ${totalRemaining > 0 ? 'neg' : 'pos'}">${fmt(totalRemaining)}</div><div class="stat-sub">${withBalance.length} הזמנות</div></div>
  `;

  const upcoming = futureBookings.slice(0, 5);
  $('dashboard-upcoming').innerHTML = upcoming.length ? upcoming.map(b => `
    <div style="display:flex;align-items:center;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--border)">
      <div>
        <div style="font-weight:700;font-size:13px">${esc(b.name)}</div>
        <div style="font-size:11px;color:var(--text3)">${typeLabel(b.type)} • ${fmtDate(b.dateFrom)}${b.dateTo && b.dateTo !== b.dateFrom ? ' — ' + fmtDate(b.dateTo) : ''}</div>
      </div>
      <div class="num">${fmt(b.amount)}</div>
    </div>
  `).join('') : `<div class="empty-state" style="padding:20px 0"><p style="font-size:13px">אין הזמנות קרובות</p></div>`;

  $('dashboard-balances').innerHTML = withBalance.length ? withBalance.slice(0, 5).map(({b, rem}) => `
    <div style="display:flex;align-items:center;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--border)">
      <div>
        <div style="font-weight:700;font-size:13px">${esc(b.name)}</div>
        <div style="font-size:11px;color:var(--text3)">${fmtDate(b.dateFrom)}</div>
      </div>
      <div class="num neg">${fmt(rem)}</div>
    </div>
  `).join('') : `<div class="empty-state" style="padding:20px 0"><p style="font-size:13px">אין יתרות פתוחות 🎉</p></div>`;
}

function renderBookings() {
  // Stats
  const active = state.bookings.filter(b => b.status !== 'cancelled' && b.status !== 'passed');
  const todayStr = new Date().toISOString().substring(0,10);
  const realizedBookings = state.bookings.filter(b => b.status !== 'cancelled' && (b.status === 'passed' || (b.dateTo || b.dateFrom || '') < todayStr));
  const futureBookings = active.filter(b => (b.dateFrom || '') >= todayStr);
  const totalIncome = realizedBookings.reduce((a, b) => a + (b.amount || 0), 0);
  const totalFuture = futureBookings.reduce((a, b) => a + (b.amount || 0), 0);
  const totalPaidAll = active.reduce((a, b) => a + totalPaid(b), 0);
  const totalRemaining = active.reduce((a, b) => a + (b.amount || 0), 0) - totalPaidAll;
  const thisMonth = new Date().toISOString().substring(0, 7);
  const thisMonthBookings = active.filter(b => (b.dateFrom || '').startsWith(thisMonth));

  $('bookings-stats').innerHTML = `
    <div class="stat-card blue"><div class="stat-label">הזמנות פתוחות</div><div class="stat-value">${active.length}</div><div class="stat-sub">${thisMonthBookings.length} החודש</div></div>
    <div class="stat-card green"><div class="stat-label">הכנסות שהתממשו</div><div class="stat-value pos">${fmt(totalIncome)}</div><div class="stat-sub">מ-${realizedBookings.length} אירועים שעברו</div></div>
    <div class="stat-card blue" style="--before-bg: linear-gradient(90deg,var(--accent2),var(--accent))"><div class="stat-label">הכנסות עתידיות</div><div class="stat-value" style="color:var(--accent2)">${fmt(totalFuture)}</div><div class="stat-sub">${futureBookings.length} הזמנות קדימה</div></div>
    <div class="stat-card gold"><div class="stat-label">שולם (הזמנות פתוחות)</div><div class="stat-value gold">${fmt(totalPaidAll)}</div></div>
    <div class="stat-card red"><div class="stat-label">יתרה לגביה</div><div class="stat-value ${totalRemaining > 0 ? 'neg' : 'pos'}">${fmt(totalRemaining)}</div><div class="stat-sub">טרם שולם</div></div>
  `;

  const search = ($('search-bookings').value || '').toLowerCase();
  const filterType = $('filter-type').value;
  const filterStatus = $('filter-status').value;

  let bookings = [...state.bookings].filter(b => {
    if (search && !b.name.toLowerCase().includes(search) && !(b.phone||'').includes(search)) return false;
    if (filterType && b.type !== filterType) return false;
    if (filterStatus === '') {
      // Default: hide cancelled and passed
      if (b.status === 'cancelled' || b.status === 'passed') return false;
    } else if (filterStatus === 'all') {
      // Show everything
    } else {
      if (b.status !== filterStatus) return false;
    }
    return true;
  }).sort((a, b) => (a.dateFrom || '') > (b.dateFrom || '') ? 1 : -1);

  const container = $('bookings-list');
  if (!bookings.length) {
    container.innerHTML = `<div class="empty-state"><div class="empty-icon">📭</div><p>אין הזמנות</p><small>לחץ "הזמנה חדשה" להתחיל</small></div>`;
    return;
  }

  container.innerHTML = bookings.map(b => {
    const paid = totalPaid(b);
    const rem = b._overrideAdvance !== undefined && b._overrideAdvance !== null ? b.amount - b._overrideAdvance : remaining(b);
    const typeChip = { shabbat: 'badge-success', holiday: 'badge-purple', daily: 'badge-orange' }[b.type] || 'badge-gray';
    const pct = b.amount ? Math.min(100, Math.round(paid/b.amount*100)) : 0;
    const paymentsHtml = (b.payments || []).map(p => {
      const meth = { cash: '💵 מזומן', transfer: '🏦 העברה', bit: '📱 Bit', paybox: '📱 Paybox', check: "📝 צ'ק", other: '🔄 אחר' }[p.method] || p.method;
      const typ = { advance: 'מקדמה', final: 'סופי', partial: 'חלקי' }[p.type] || p.type;
      return `<span class="badge badge-gray" style="margin-left:4px;margin-bottom:4px;">${meth} • ${typ} • ${fmt(p.amount)}${p.date ? ' • '+fmtDate(p.date) : ''}${p.note ? ' • '+p.note : ''}</span>`;
    }).join('');
    const bookingExpenses = state.expenses.filter(e => e.bookingId == b.id);
    const bookingExpTotal = bookingExpenses.reduce((a,e) => a + totalExpense(e), 0);
    const bookingExpHtml = bookingExpenses.length ? `
      <div style="margin-top:8px;padding:8px 10px;background:var(--surface2);border-radius:8px;border:1px solid var(--border)">
        <div style="font-size:11px;color:var(--text3);font-weight:700;margin-bottom:4px">💸 הוצאות שנרשמו: <span style="color:var(--red)">${fmt(bookingExpTotal)}</span></div>
        ${bookingExpenses.map(e => `
          <div style="padding:5px 0;border-top:1px solid var(--border)">
            <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:12px">
              <span>📅 ${fmtDate(e.date)} • <b style="color:var(--red)">${fmt(totalExpense(e))}</b>
                ${e.broker ? ` • תיווך ${fmt(e.broker)}` : ''}${e.cleaning ? ` • ניקיון ${fmt(e.cleaning)}` : ''}${e.other ? ` • אחר ${fmt(e.other)}` : ''}
              </span>
              <span>
                <button class="action-btn" onclick="openExpenseModal(${e.id})" title="ערוך">✏️</button>
                <button class="action-btn danger" onclick="deleteExpense(${e.id})" title="מחק">🗑️</button>
              </span>
            </div>
            ${(e.laundry||[]).length ? `<div style="margin-top:4px;display:flex;flex-wrap:wrap;gap:4px">${(e.laundry||[]).map(l=>`<span class="badge badge-gray">${esc(l.name||'מנקה')} • ${l.category==='laundry'?'כביסה':l.category==='both'?'ניקיון+כביסה':'ניקיון'} • ${fmt(l.amount)}</span>`).join('')}</div>` : ''}
            ${(e.otherItems||[]).length ? `<div style="margin-top:4px;display:flex;flex-wrap:wrap;gap:4px">${(e.otherItems||[]).map(r=>`<span class="badge badge-gray">➕ ${esc(r.desc||'הוצאה')} • ${fmt(r.amount)}</span>`).join('')}</div>` : ''}
            ${e.notes ? `<div style="margin-top:4px;font-size:11px;color:var(--text3)">📝 ${esc(e.notes)}</div>` : ''}
          </div>
        `).join('')}
      </div>
    ` : '';


    return `<div class="booking-card ${b.type}">
      <div class="booking-card-header">
        <div>
          <div class="booking-name">${esc(b.name)} ${statusBadge(b.status)}</div>
          <div class="booking-meta">
            <span class="badge ${typeChip}">${typeLabel(b.type)}</span>
            ${b.parasha ? `<span class="badge badge-purple" style="margin-right:4px">📖 ${esc(b.parasha)}</span>` : ''}
            📅 ${fmtDate(b.dateFrom)}${b.dateTo && b.dateTo !== b.dateFrom ? ' — '+fmtDate(b.dateTo) : ''}
            ${(()=>{ const h = toHebrewDate(b.dateFrom); return `<span style="color:var(--text3);font-size:11px"> • ${h.dayName}${h.isShabbat?' ✦':''}</span><span style="color:${h.isShabbat?'#c8960b':'var(--text3)'};font-size:10px;margin-right:4px;"> ${h.hebrew}</span>`; })()}
            ${b.phone ? ' • 📞 '+b.phone : ''}
            ${b.email ? ' • ✉️ '+b.email : ''}
          </div>
          <div style="margin-top:6px;font-size:12px;color:var(--text3)">
            🛏️ ${(b.bedsSheets||0)} עם מצעים, ${(b.bedsNoSheets||0)} ללא מצעים
            ${b.guests ? ' • 👥 '+b.guests+' אנשים' : ''}
            ${b.broker ? ' • 🤝 תיווך: '+fmt(b.broker) : ''}
          </div>
          ${(b.rooms||[]).length ? `<div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:6px">${(b.rooms||[]).map(r=>`<div style="background:var(--surface3);border:1px solid var(--border);border-radius:6px;padding:4px 9px;font-size:11px;"><b style="color:var(--accent)">🚪 ${esc(r.roomName||'חדר')}</b> ${r.guests?'— '+esc(r.guests):''}</div>`).join('')}</div>` : ''}
        </div>
        <div style="text-align:left;min-width:120px">
          <div class="booking-amount">${fmt(b.amount)}</div>
          <div style="font-size:11px;color:var(--green)">שולם: ${fmt(paid)}</div>
          ${rem > 0 ? `<div style="font-size:11px;color:var(--red)">נותר: ${fmt(rem)}</div>` : '<div style="font-size:11px;color:var(--green)">✓ שולם במלואו</div>'}
          <div style="background:var(--border);border-radius:2px;height:4px;margin-top:6px;overflow:hidden">
            <div style="width:${pct}%;height:100%;background:linear-gradient(90deg,var(--green),var(--accent));border-radius:2px"></div>
          </div>
        </div>
      </div>
      ${paymentsHtml ? `<div style="margin-top:8px">${paymentsHtml}</div>` : ''}
      ${bookingExpHtml}
      ${b.notes ? `<div style="margin-top:6px;font-size:12px;color:var(--text3)">📝 ${esc(b.notes)}</div>` : ''}
      <div class="booking-actions">
        <button class="btn btn-outline btn-sm" onclick="openBookingModal(${b.id})">✏️ ערוך</button>
        <button class="btn btn-gold btn-sm" onclick="openContractModal(${b.id})">📜 שלח חוזה</button>
        <button class="btn btn-outline btn-sm" style="color:var(--orange)" onclick="openQuickExpenseModalById(${b.id})">💸 הוסף הוצאות</button>
        ${b.status !== 'passed' ? `<button class="btn btn-outline btn-sm" style="color:var(--text3)" onclick="markAsPassed(${b.id})">✅ סמן כעבר</button>` : `<button class="btn btn-outline btn-sm" style="color:var(--accent)" onclick="unmarkPassed(${b.id})">↩️ החזר לפתוח</button>`}
        <button class="btn btn-danger btn-sm" onclick="deleteBooking(${b.id})">🗑️ מחק</button>
      </div>
    </div>`;
  }).join('');
}

// ===== CALENDAR =====
const MONTHS_HE = ['ינואר','פברואר','מרץ','אפריל','מאי','יוני','יולי','אוגוסט','ספטמבר','אוקטובר','נובמבר','דצמבר'];

function renderCalendar() {
  const [y, m] = state.calendarMonth.split('-').map(Number);
  $('cal-month-label').textContent = `${MONTHS_HE[m-1]} ${y}`;

  const firstDay = new Date(y, m-1, 1);
  const daysInMonth = new Date(y, m, 0).getDate();
  // Sunday=0 is col 0 in our grid (א')
  let startWeekday = firstDay.getDay();

  const grid = $('cal-grid');
  grid.innerHTML = '';
  const today = new Date().toISOString().substring(0,10);
  const mk = y + '-' + String(m).padStart(2,'0');

  // Group bookings by day ranges
  const dayBookings = {};
  for (const b of state.bookings) {
    if (b.status === 'cancelled') continue;
    const from = b.dateFrom || '';
    const to = b.dateTo || from;
    // Check each day in month
    for (let d = 1; d <= daysInMonth; d++) {
      const ds = mk + '-' + String(d).padStart(2,'0');
      if (ds >= from && ds <= to) {
        if (!dayBookings[ds]) dayBookings[ds] = [];
        dayBookings[ds].push(b);
      }
    }
  }

  for (let i = 0; i < startWeekday; i++) {
    const div = document.createElement('div');
    div.className = 'cal-day empty';
    grid.appendChild(div);
  }

  for (let d = 1; d <= daysInMonth; d++) {
    const ds = mk + '-' + String(d).padStart(2,'0');
    const weekday = new Date(y, m-1, d).getDay();
    const bk = dayBookings[ds] || [];
    const cell = document.createElement('div');
    let cls = 'cal-day';
    if (bk.length) cls += ' has-booking';
    if (ds === today) cls += ' today';
    if (ds === state.calendarSelectedDay) cls += ' selected';
    if (weekday === 5) cls += ' friday';
    if (weekday === 6) cls += ' saturday';
    cell.className = cls;
    cell.onclick = () => openCalDay(ds);

    const hebDate = toHebrewDate(ds);
    const jewishInfo = getJewishInfo(ds);
    if (jewishInfo.isHoliday) cell.classList.add('holiday-day');
    if (jewishInfo.isErevHoliday) cell.classList.add('friday');

    let html = `<div class="cal-daynum">${d}</div>`;
    // Day name (tiny)
    html += `<div style="font-size:9px;color:var(--text3);margin-bottom:1px;">${hebDate.dayName.replace('יום ','')}</div>`;
    // Hebrew date
    const hebColor = jewishInfo.isHoliday ? '#c0392b' : hebDate.isShabbat ? '#c8960b' : 'var(--text3)';
    const hebWeight = (jewishInfo.isHoliday || hebDate.isShabbat) ? '700' : '400';
    html += `<div style="font-size:8px;color:${hebColor};margin-bottom:2px;font-weight:${hebWeight};">${hebDate.hebrew}</div>`;
    // Holiday name
    if (jewishInfo.holiday) {
      const hcolor = jewishInfo.isHoliday ? '#c0392b' : '#e67e22';
      html += `<div style="font-size:8px;font-weight:800;color:${hcolor};margin-bottom:2px;line-height:1.2;">${jewishInfo.holiday}</div>`;
    }
    // Parasha on shabbat
    if (jewishInfo.parasha && !jewishInfo.holiday) {
      html += `<div style="font-size:8px;font-weight:700;color:#c8960b;margin-bottom:2px;">${jewishInfo.parasha}</div>`;
    }
    for (const b of bk.slice(0, 3)) {
      const chipCls = { shabbat: 'shabbat', holiday: 'holiday', daily: 'daily' }[b.type] || '';
      const label = b.parasha ? esc(b.parasha) : esc(b.name.split(' ')[0]);
      html += `<div class="cal-booking-chip ${chipCls}" title="${esc(b.name)}">${label}</div>`;
    }
    if (bk.length > 3) html += `<div style="font-size:10px;color:var(--text3)">+${bk.length-3} עוד</div>`;
    cell.innerHTML = html;
    grid.appendChild(cell);
  }

  if (state.calendarSelectedDay) openCalDay(state.calendarSelectedDay);
}

function openCalDay(ds) {
  state.calendarSelectedDay = ds;
  const detail = $('cal-day-detail');
  const bk = state.bookings.filter(b => b.status !== 'cancelled' && ds >= (b.dateFrom||'') && ds <= (b.dateTo||b.dateFrom||''));
  const exp = state.expenses.filter(e => e.date === ds);
  const [y,mo,d] = ds.split('-');
  const dayNames = ['ראשון','שני','שלישי','רביעי','חמישי','שישי','שבת'];
  const wd = new Date(y, mo-1, d).getDay();
  const hebInfo = toHebrewDate(ds);

  let html = `<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
    <div>
      <b style="font-size:15px">${hebInfo.dayName}, ${hebInfo.greg}</b>
      <div style="font-size:11px;color:${hebInfo.isShabbat?'#c8960b':'var(--text3)'};font-weight:${hebInfo.isShabbat?'700':'400'};margin-top:1px;">${hebInfo.hebrew}</div>
      ${hebInfo.isShabbat ? '<span style="color:#c8960b;font-weight:800;margin-right:6px;font-size:13px">✦ שבת קודש ✦</span>' : ''}
      ${hebInfo.isFriday ? '<span style="color:var(--green);font-size:12px">(ערב שבת)</span>' : ''}
    </div>
    <button class="btn btn-primary btn-sm" onclick="openBookingModal();$('b-date-from').value='${ds}'">➕ הזמנה</button>
  </div>`;

  if (!bk.length && !exp.length) {
    html += `<p style="color:var(--text3);font-size:13px">אין פעילות ביום זה</p>`;
  }

  for (const b of bk) {
    const paid = totalPaid(b);
    html += `<div style="background:var(--surface2);border-radius:8px;padding:10px;margin-bottom:8px;">
      <b>${esc(b.name)}</b> ${statusBadge(b.status)} <span class="badge badge-blue">${typeLabel(b.type)}</span><br>
      <span style="font-size:12px;color:var(--text2)">📞 ${esc(b.phone)} ${b.email?'• ✉️ '+esc(b.email):''}</span><br>
      <span style="font-size:12px">💰 ${fmt(b.amount)} • שולם: ${fmt(paid)} • נותר: ${fmt(remaining(b))}</span><br>
      <span style="font-size:12px;color:var(--text3)">🛏️ ${b.bedsSheets||0}+${b.bedsNoSheets||0} מיטות</span>
    </div>`;
  }

  for (const e of exp) {
    const total = (e.broker||0)+(e.cleaning||0)+(e.other||0)+(e.laundry||[]).reduce((a,l)=>a+(l.amount||0),0);
    html += `<div style="background:rgba(248,113,113,.08);border:1px solid rgba(248,113,113,.2);border-radius:8px;padding:10px;margin-bottom:8px;">
      <b style="color:var(--red)">💸 הוצאות: ${fmt(total)}</b><br>
      <span style="font-size:12px;color:var(--text2)">תיווך: ${fmt(e.broker)} • ניקיון: ${fmt(e.cleaning)} • אחר: ${fmt(e.other)}</span>
    </div>`;
  }

  detail.innerHTML = html;
  detail.style.display = 'block';
  // Re-render grid to update selection highlight
  const cells = $('cal-grid').querySelectorAll('.cal-day');
  cells.forEach(c => c.classList.remove('selected'));
  renderCalendar();
  detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function calPrev() {
  const [y, m] = state.calendarMonth.split('-').map(Number);
  let nm = m-1, ny = y;
  if (nm < 1) { nm = 12; ny--; }
  state.calendarMonth = ny+'-'+String(nm).padStart(2,'0');
  state.calendarSelectedDay = null;
  $('cal-day-detail').style.display = 'none';
  renderCalendar();
}
function calNext() {
  const [y, m] = state.calendarMonth.split('-').map(Number);
  let nm = m+1, ny = y;
  if (nm > 12) { nm = 1; ny++; }
  state.calendarMonth = ny+'-'+String(nm).padStart(2,'0');
  state.calendarSelectedDay = null;
  $('cal-day-detail').style.display = 'none';
  renderCalendar();
}
function calToday() {
  state.calendarMonth = new Date().toISOString().substring(0,7);
  state.calendarSelectedDay = new Date().toISOString().substring(0,10);
  renderCalendar();
}

// ===== GOOGLE CALENDAR EXPORT =====
function exportGoogleCalendar() {
  const active = state.bookings.filter(b => b.status !== 'cancelled');
  if (!active.length) { alert('אין הזמנות לייצוא'); return; }

  let ics = `BEGIN:VCALENDAR\r\nVERSION:2.0\r\nPRODID:-//Campus Rental//IL\r\nCALSCALE:GREGORIAN\r\nMETHOD:PUBLISH\r\n`;

  for (const b of active) {
    const from = (b.dateFrom || '').replace(/-/g,'');
    const to = b.dateTo ? addDay(b.dateTo).replace(/-/g,'') : addDay(b.dateFrom).replace(/-/g,'');
    const summary = `${typeLabel(b.type)} - ${b.name}`;
    const desc = `טלפון: ${b.phone}\\nסכום: ${fmt(b.amount)}\\nשולם: ${fmt(totalPaid(b))}\\nנותר: ${fmt(remaining(b))}\\nמיטות: ${b.bedsSheets||0} עם מצעים, ${b.bedsNoSheets||0} ללא\\n${b.notes||''}`;
    const uid = `booking-${b.id}@campus-rental`;
    ics += `BEGIN:VEVENT\r\nUID:${uid}\r\nDTSTAMP:${new Date().toISOString().replace(/[-:]/g,'').substring(0,15)}Z\r\nDTSTART;VALUE=DATE:${from}\r\nDTEND;VALUE=DATE:${to}\r\nSUMMARY:${summary}\r\nDESCRIPTION:${desc}\r\nEND:VEVENT\r\n`;
  }
  ics += `END:VCALENDAR`;

  const blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = 'campus_bookings.ics'; a.click();
  URL.revokeObjectURL(url);
}

function addDay(ds) {
  const d = new Date(ds);
  d.setDate(d.getDate()+1);
  return d.toISOString().substring(0,10);
}

